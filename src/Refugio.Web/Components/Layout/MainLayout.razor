@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject SettingsCacheService SettingsCache

@{
    var userName = HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.Name)?.Value ?? "User";
    var initials = string.Concat(userName.Split(' ').Take(2).Select(w => char.ToUpper(w.FirstOrDefault())));
    var ctx = HttpContextAccessor.HttpContext;
    var currentUrl = ctx?.Request.Path.Value + ctx?.Request.QueryString.Value ?? "/";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var isSpanish = currentCulture.Name.StartsWith("es");
    var isPortuguese = currentCulture.Name.StartsWith("pt");
    var isCatalan = currentCulture.Name == "ca-ES";
    var langLabel = isCatalan ? "CA" : isPortuguese ? "PT" : isSpanish ? "ES" : "EN";
    var brandName = _settings?.Name ?? L["App_Name"].Value;
    var brandPhrase = _settings?.Phrase ?? L["App_Branch"].Value;
    var brandLogo = _settings?.LogoUrl;
}

<div class="flex h-screen overflow-hidden bg-background">
    <!-- Sidebar -->
    <aside class="w-64 fixed left-0 top-0 h-screen bg-surface-container flex flex-col py-md border-r border-outline-variant z-50">
        <div class="px-md mb-lg">
            <div class="flex items-center gap-sm">
                <div class="w-[100px] h-[100px] rounded-lg overflow-hidden flex items-center justify-center flex-shrink-0">
                    @if (!string.IsNullOrEmpty(brandLogo))
                    {
                        <img src="@brandLogo" alt="logo" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-on-primary" style="font-variation-settings:'FILL' 1">pets</span>
                        </div>
                    }
                </div>
                <div>
                    <h1 class="font-headline-md text-headline-md text-primary leading-tight">@brandName</h1>
                    <p class="text-label-sm font-label-sm text-on-surface-variant">@brandPhrase</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 space-y-1 px-sm overflow-y-auto">
            <NavLink href="/" Match="NavLinkMatch.All"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="font-label-md text-label-md">@L["Nav_Dashboard"]</span>
            </NavLink>
            <NavLink href="/dogs"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">pets</span>
                <span class="font-label-md text-label-md">@L["Nav_Dogs"]</span>
            </NavLink>
            <NavLink href="/health"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">medical_services</span>
                <span class="font-label-md text-label-md">@L["Nav_Health"]</span>
            </NavLink>
            <NavLink href="/adoptions"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">favorite</span>
                <span class="font-label-md text-label-md">@L["Nav_Adoptions"]</span>
            </NavLink>
            <NavLink href="/funds"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">payments</span>
                <span class="font-label-md text-label-md">@L["Nav_Funds"]</span>
            </NavLink>
            <NavLink href="/calendar"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">calendar_month</span>
                <span class="font-label-md text-label-md">@L["Nav_Calendar"]</span>
            </NavLink>
            <NavLink href="/volunteers"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">group</span>
                <span class="font-label-md text-label-md">@L["Nav_Volunteers"]</span>
            </NavLink>
            <NavLink href="/reports"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">bar_chart</span>
                <span class="font-label-md text-label-md">@L["Nav_Reports"]</span>
            </NavLink>
            <AuthorizeView Roles="Manager">
            <NavLink href="/admin/deleted"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-error-container/20 transition-all duration-200"
                     ActiveClass="text-error font-bold border-r-4 border-error bg-error-container/10">
                <span class="material-symbols-outlined">admin_panel_settings</span>
                <span class="font-label-md text-label-md">@L["Nav_AdminDeleted"]</span>
            </NavLink>
            <NavLink href="/settings"
                     class="flex items-center gap-sm px-md py-3 text-on-surface-variant hover:bg-primary-container/20 transition-all duration-200"
                     ActiveClass="text-primary font-bold border-r-4 border-primary bg-primary-container/10">
                <span class="material-symbols-outlined">settings</span>
                <span class="font-label-md text-label-md">@L["Nav_Settings"]</span>
            </NavLink>
            </AuthorizeView>
        </nav>
        <div class="px-sm mt-auto py-md">
            <a href="/dogs/new" class="w-full mb-md bg-primary text-on-primary py-3 rounded-lg font-label-md text-label-md flex items-center justify-center gap-sm hover:brightness-110 transition-all">
                <span class="material-symbols-outlined">add</span>
                @L["Nav_CheckIn"]
            </a>
        </div>
    </aside>

    <!-- Main area -->
    <div class="ml-64 flex-1 flex flex-col min-h-screen overflow-y-auto">
        <!-- Top bar -->
        <header class="h-16 bg-surface-container-low shadow-sm flex items-center justify-between px-margin-desktop sticky top-0 z-40 border-b border-outline-variant">
            <div class="flex items-center gap-md">
                <div class="relative">
                    <span class="absolute inset-y-0 left-3 flex items-center text-on-surface-variant">
                        <span class="material-symbols-outlined">search</span>
                    </span>
                    <input class="pl-10 pr-4 py-2 bg-surface-container-high border-none rounded-full w-80 text-body-sm focus:ring-2 focus:ring-primary transition-all"
                           placeholder="@L["Nav_SearchPlaceholder"]" type="text" />
                </div>
            </div>
            <div class="flex items-center gap-md">
                <button class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-surface-container-high transition-all text-on-surface-variant">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <div class="h-8 w-px bg-outline-variant"></div>

                <!-- Language switcher -->
                <div class="relative group">
                    <button class="flex items-center gap-xs px-sm py-1.5 rounded-lg hover:bg-surface-container-high transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-on-surface-variant" style="font-size:18px">language</span>
                        <span class="font-label-sm text-label-sm text-on-surface">@langLabel</span>
                        <span class="material-symbols-outlined text-on-surface-variant" style="font-size:14px">expand_more</span>
                    </button>
                    <div class="absolute right-0 top-full mt-1 w-40 bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 z-50">
                        <a href="/set-language?culture=en-US&returnUrl=@Uri.EscapeDataString(currentUrl)"
                           class="flex items-center gap-sm px-md py-3 hover:bg-surface-container rounded-t-xl text-body-sm transition-colors @(!isSpanish && !isPortuguese && !isCatalan ? "text-primary font-bold" : "text-on-surface")">
                            @L["Lang_English"]
                        </a>
                        <div class="h-px bg-outline-variant/30 mx-md"></div>
                        <a href="/set-language?culture=es-ES&returnUrl=@Uri.EscapeDataString(currentUrl)"
                           class="flex items-center gap-sm px-md py-3 hover:bg-surface-container text-body-sm transition-colors @(isSpanish ? "text-primary font-bold" : "text-on-surface")">
                            @L["Lang_Spanish"]
                        </a>
                        <div class="h-px bg-outline-variant/30 mx-md"></div>
                        <a href="/set-language?culture=pt-BR&returnUrl=@Uri.EscapeDataString(currentUrl)"
                           class="flex items-center gap-sm px-md py-3 hover:bg-surface-container text-body-sm transition-colors @(isPortuguese ? "text-primary font-bold" : "text-on-surface")">
                            @L["Lang_Portuguese"]
                        </a>
                        <div class="h-px bg-outline-variant/30 mx-md"></div>
                        <a href="/set-language?culture=ca-ES&returnUrl=@Uri.EscapeDataString(currentUrl)"
                           class="flex items-center gap-sm px-md py-3 hover:bg-surface-container rounded-b-xl text-body-sm transition-colors @(isCatalan ? "text-primary font-bold" : "text-on-surface")">
                            @L["Lang_Catalan"]
                        </a>
                    </div>
                </div>

                <div class="h-8 w-px bg-outline-variant"></div>

                <!-- User dropdown (CSS hover, no JS needed) -->
                <div class="relative group">
                    <button class="flex items-center gap-sm px-sm py-1.5 rounded-lg hover:bg-surface-container-high transition-all cursor-pointer">
                        <div class="w-8 h-8 rounded-full bg-primary-fixed flex items-center justify-center text-on-primary-fixed font-bold text-sm">@initials</div>
                        <span class="font-label-md text-label-md text-on-surface">@userName</span>
                        <span class="material-symbols-outlined text-on-surface-variant" style="font-size:18px">expand_more</span>
                    </button>
                    <div class="absolute right-0 top-full mt-1 w-52 bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 z-50">
                        <a href="/change-password" class="flex items-center gap-sm px-md py-3 text-on-surface hover:bg-surface-container rounded-t-xl text-body-sm transition-colors">
                            <span class="material-symbols-outlined text-on-surface-variant" style="font-size:18px">lock</span>
                            @L["Nav_ChangePassword"]
                        </a>
                        <div class="h-px bg-outline-variant/30 mx-md"></div>
                        <a href="/auth/logout" class="flex items-center gap-sm px-md py-3 text-error hover:bg-error-container/20 rounded-b-xl text-body-sm transition-colors">
                            <span class="material-symbols-outlined" style="font-size:18px">logout</span>
                            @L["Nav_SignOut"]
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="flex-1">
            @Body
        </main>
    </div>
</div>

@code {
    private ShelterSettings? _settings;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsCache.GetSettingsAsync();
    }
}
