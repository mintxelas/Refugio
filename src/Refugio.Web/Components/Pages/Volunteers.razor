@page "/volunteers"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Nav_Volunteers"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-primary">@L["Volunteers_Title"]</h2>
            <p class="text-body-md text-on-surface-variant">@L["Volunteers_Subtitle"]</p>
        </div>
    </div>

    <!-- Add Volunteer collapsible form -->
    <AuthorizeView Roles="Manager">
    <details class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
        <summary class="flex items-center justify-between px-md py-4 cursor-pointer hover:bg-surface-container transition-colors select-none list-none">
            <span class="flex items-center gap-sm font-label-md text-label-md text-primary">
                <span class="material-symbols-outlined">person_add</span>
                @L["Volunteers_AddVolunteer"]
            </span>
            <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
        </summary>
        <div class="px-md pb-md border-t border-outline-variant/30 pt-md">
            <form method="post" @formname="add-vol" @onsubmit="AddVolunteer" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Volunteers_AddVolunteer"] – @L["Common_Name"] *</label>
                        <input name="Name" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Email"] *</label>
                        <input name="Email" type="email" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Phone"]</label>
                        <input name="Phone" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Role"]</label>
                        <input name="Role" placeholder="@L["Volunteers_RolePlaceholder"]" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>

                <div class="border border-outline-variant/50 rounded-lg px-md py-sm bg-surface-container/30">
                    <input type="checkbox" name="CanLogin" id="canLogin" value="true"
                           class="peer w-4 h-4 accent-primary cursor-pointer align-middle" />
                    <label for="canLogin" class="ml-xs font-label-md text-label-md text-on-surface cursor-pointer select-none align-middle">
                        @L["Volunteers_CanLogin"]
                    </label>
                    <div class="hidden peer-checked:grid grid-cols-2 gap-md mt-sm pt-sm border-t border-outline-variant/20">
                        <div>
                            <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Volunteers_PasswordRequired"]</label>
                            <input name="Password" type="password" minlength="6"
                                   class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                        </div>
                        <div class="flex items-center">
                            <p class="text-body-sm text-on-surface-variant">@L["Volunteers_LoginHint"]</p>
                        </div>
                        <div class="col-span-2">
                            <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Volunteers_DefaultLanguage"]</label>
                            <select name="PreferredLanguage" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                                @foreach (var (culture, key) in _languages)
                                {
                                    <option value="@culture" selected="@(_defaultLanguage == culture ? "selected" : null)">@L[key]</option>
                                }
                            </select>
                            <p class="text-body-sm text-on-surface-variant mt-xs">@L["Volunteers_DefaultLanguageHint"]</p>
                        </div>
                    </div>
                </div>

                <div class="flex gap-sm justify-end">
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                        @L["Volunteers_AddVolunteer"]
                    </button>
                </div>
            </form>
        </div>
    </details>
    </AuthorizeView>

    <!-- Filter tabs -->
    <div class="flex gap-sm">
        @foreach (var (filterVal, label) in new (string, string)[] {
            ("", L["Common_All"].Value),
            ("Active", L["Common_Active"].Value),
            ("Inactive", L["Common_Inactive"].Value),
            ("Pending", L["Common_Pending"].Value)
        })
        {
            var isActive = (Filter ?? "") == filterVal;
            <a href="@(filterVal == "" ? "/volunteers" : $"/volunteers?filter={filterVal}")"
               class="px-md py-2 rounded-full font-label-md text-label-md border transition-all @(isActive ? "bg-primary text-on-primary border-primary" : "border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary")">
                @label
            </a>
        }
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-gutter">
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md flex items-center gap-md">
            <div class="w-12 h-12 rounded-lg bg-primary-fixed flex items-center justify-center text-on-primary-fixed">
                <span class="material-symbols-outlined">group</span>
            </div>
            <div>
                <p class="text-label-md text-on-surface-variant">@L["Volunteers_Total"]</p>
                <p class="font-headline-md text-headline-md text-primary">@_counts.Total</p>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md flex items-center gap-md">
            <div class="w-12 h-12 rounded-lg bg-primary-fixed flex items-center justify-center text-on-primary-fixed">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div>
                <p class="text-label-md text-on-surface-variant">@L["Common_Active"]</p>
                <p class="font-headline-md text-headline-md text-primary">@_counts.Active</p>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md flex items-center gap-md">
            <div class="w-12 h-12 rounded-lg bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
                <span class="material-symbols-outlined">pending</span>
            </div>
            <div>
                <p class="text-label-md text-on-surface-variant">@L["Volunteers_PendingReview"]</p>
                <p class="font-headline-md text-headline-md text-secondary">@_counts.Pending</p>
            </div>
        </div>
    </div>

    <!-- Volunteers table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
        <div class="flex px-md py-3 bg-surface-container text-on-surface-variant font-label-md text-label-sm uppercase tracking-wider">
            <div class="flex-[2]">@L["Volunteers_VolunteerCol"]</div>
            <div class="flex-1">@L["Common_Role"]</div>
            <div class="flex-1">@L["Volunteers_Joined"]</div>
            <div class="flex-1">@L["Common_Status"]</div>
            <div class="flex-1 text-right">@L["Common_Actions"]</div>
        </div>
        <div class="divide-y divide-outline-variant/20">
            @foreach (var (v, i) in _volunteers.Select((v, i) => (v, i)))
            {
                <div class="relative flex items-center px-md py-3 @(i % 2 == 1 ? "bg-tertiary-fixed/5" : "") hover:bg-surface-container transition-colors cursor-pointer">
                    <a href="/volunteers/@v.Id" class="absolute inset-0" aria-label="Edit @v.Name"></a>
                    <div class="flex-[2] flex items-center gap-sm pointer-events-none">
                        <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold">
                            @string.Concat(v.Name.Split(' ').Take(2).Select(w => w.FirstOrDefault()))
                        </div>
                        <div>
                            <p class="font-label-md text-on-surface flex items-center gap-xs">
                                @v.Name
                                @if (v.CanLogin)
                                {
                                    <span class="material-symbols-outlined text-primary" style="font-size:14px" title="Can log in">key</span>
                                }
                            </p>
                            <p class="text-body-sm text-on-surface-variant">@v.Email</p>
                        </div>
                    </div>
                    <div class="flex-1 text-body-sm text-on-surface-variant pointer-events-none">@v.Role</div>
                    <div class="flex-1 text-body-sm text-on-surface-variant pointer-events-none">@v.JoinDate.ToString("MMM yyyy")</div>
                    <div class="flex-1 pointer-events-none">
                        <span class="@StatusBadge(v.Status) px-sm py-0.5 rounded-full text-label-sm font-bold">@L[$"VolunteerStatus_{v.Status}"]</span>
                    </div>
                    <div class="flex-1 flex justify-end gap-xs relative z-10">
                        <AuthorizeView Roles="Manager">
                            @if (v.Status == VolunteerStatus.Pending || v.Status == VolunteerStatus.Inactive)
                            {
                                <form method="post" action="/api/volunteers/@v.Id/activate" class="contents">
                                    <AntiforgeryToken />
                                    <button type="submit" class="px-xs py-1 bg-primary/10 text-primary rounded text-label-sm font-bold hover:bg-primary/20 transition-all">@L["Volunteers_Activate"]</button>
                                </form>
                            }
                            @if (v.Status == VolunteerStatus.Active)
                            {
                                <form method="post" action="/api/volunteers/@v.Id/deactivate" class="contents">
                                    <AntiforgeryToken />
                                    <button type="submit" class="px-xs py-1 bg-secondary/10 text-secondary rounded text-label-sm font-bold hover:bg-secondary/20 transition-all">@L["Volunteers_Deactivate"]</button>
                                </form>
                            }
                        </AuthorizeView>
                    </div>
                </div>
            }
        </div>
        @if (!_volunteers.Any())
        {
            <div class="py-lg text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-5xl block mb-sm">group_off</span>
                <p class="text-body-lg">@L["Volunteers_NoFound"]</p>
            </div>
        }
    </div>

    @{
        var totalPages = _totalCount == 0 ? 1 : (int)Math.Ceiling(_totalCount / (double)_pageSize);
        var filterSuffix = Filter is { Length: > 0 } f ? $"&filter={f}" : "";
    }
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between">
            <p class="text-body-sm text-on-surface-variant">
                @string.Format(L["Pagination_Showing"].Value, (_currentPage - 1) * _pageSize + 1, Math.Min(_currentPage * _pageSize, _totalCount), _totalCount)
            </p>
            <div class="flex gap-xs">
                @if (_currentPage > 1)
                {
                    <a href="@($"/volunteers?page={_currentPage - 1}{filterSuffix}")"
                       class="px-sm py-1 rounded border border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all font-label-sm">
                        @L["Pagination_Prev"]
                    </a>
                }
                @for (var p = Math.Max(1, _currentPage - 2); p <= Math.Min(totalPages, _currentPage + 2); p++)
                {
                    var pCopy = p;
                    <a href="@($"/volunteers?page={pCopy}{filterSuffix}")"
                       class="px-sm py-1 rounded border @(pCopy == _currentPage ? "bg-primary text-on-primary border-primary" : "border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary") transition-all font-label-sm">
                        @pCopy
                    </a>
                }
                @if (_currentPage < totalPages)
                {
                    <a href="@($"/volunteers?page={_currentPage + 1}{filterSuffix}")"
                       class="px-sm py-1 rounded border border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all font-label-sm">
                        @L["Pagination_Next"]
                    </a>
                }
            </div>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "filter")] private string? Filter { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private int Page { get; set; } = 1;

    private const string FName = "Name";
    private const string FEmail = "Email";
    private const string FPhone = "Phone";
    private const string FRole = "Role";
    private const string FCanLogin = "CanLogin";
    private const string FPassword = "Password";
    private const string FPreferredLanguage = "PreferredLanguage";

    private static readonly (string Culture, string Key)[] _languages =
    [
        ("en-US", "Lang_English"),
        ("es-ES", "Lang_Spanish"),
        ("pt-BR", "Lang_Portuguese"),
        ("ca-ES", "Lang_Catalan"),
    ];

    private string _defaultLanguage = "en-US";

    private const int _pageSize = 25;
    private VolunteerCounts _counts = new(0, 0, 0);
    private List<Volunteer> _volunteers = [];
    private int _totalCount;
    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        var active = System.Globalization.CultureInfo.CurrentUICulture.Name;
        _defaultLanguage = _languages.Any(l => l.Culture == active) ? active : "en-US";

        var status = Filter switch
        {
            "Active" => (VolunteerStatus?)VolunteerStatus.Active,
            "Inactive" => (VolunteerStatus?)VolunteerStatus.Inactive,
            "Pending" => (VolunteerStatus?)VolunteerStatus.Pending,
            _ => null
        };
        _currentPage = Math.Max(1, Page);
        _counts = await Api.GetVolunteerCounts();
        var paged = await Api.GetVolunteersPaged(status, _currentPage, _pageSize);
        _volunteers = paged.Items;
        _totalCount = paged.TotalCount;
    }

    private async Task AddVolunteer()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        if (ctx.User.IsInRole("Manager") != true) return;
        var form = await ctx.Request.ReadFormAsync();
        var name = GetString(form, FName);
        var email = GetString(form, FEmail);
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
            return;
        var canLogin = GetBool(form, FCanLogin);
        await Api.CreateVolunteer(new CreateVolunteer(
            name, email,
            GetStringOrNull(form, FPhone),
            GetString(form, FRole),
            null,
            canLogin,
            canLogin ? GetStringOrNull(form, FPassword) : null,
            canLogin ? GetStringOrNull(form, FPreferredLanguage) : null));
        Nav.NavigateTo("/volunteers");
    }

    private string StatusBadge(VolunteerStatus s) => s switch
    {
        VolunteerStatus.Active => "bg-primary-fixed text-on-primary-fixed",
        VolunteerStatus.Pending => "bg-secondary-container text-on-secondary-container",
        _ => "bg-surface-container-high text-on-surface-variant"
    };
}
