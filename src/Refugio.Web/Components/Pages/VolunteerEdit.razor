@page "/volunteers/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Volunteers_EditTitle"] – @L["App_Name"]</PageTitle>

@if (_volunteer is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/volunteers" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-primary">@L["Volunteers_EditTitle"]</h2>
                <p class="text-body-md text-on-surface-variant">@_volunteer.Name</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-vol" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Name"] *</label>
                        <input name="Name" required value="@_volunteer.Name"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Email"] *</label>
                        <input name="Email" type="email" required value="@_volunteer.Email"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Phone"]</label>
                        <input name="Phone" value="@_volunteer.Phone"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Role"]</label>
                        <AuthorizeView Roles="Manager">
                            <Authorized>
                                <select name="Role" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                                    <option value="Manager" selected="@(_volunteer.Role == "Manager" ? "selected" : null)">Manager</option>
                                    <option value="Volunteer" selected="@(_volunteer.Role != "Manager" ? "selected" : null)">Volunteer</option>
                                </select>
                            </Authorized>
                            <NotAuthorized>
                                <input type="hidden" name="Role" value="@_volunteer.Role" />
                                <p class="text-body-sm text-on-surface-variant py-2">@_volunteer.Role</p>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                    <div class="col-span-2">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Status"]</label>
                        <select name="Status" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            @foreach (var s in Enum.GetValues<VolunteerStatus>())
                            {
                                <option value="@s" selected="@(_volunteer.Status == s ? "selected" : null)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                        <input name="Notes" value="@_volunteer.Notes"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>

                <div class="border border-outline-variant/50 rounded-lg px-md py-sm bg-surface-container/30">
                    <input type="checkbox" name="CanLogin" id="editCanLogin" value="true"
                           checked="@(_volunteer.CanLogin)"
                           class="peer w-4 h-4 accent-primary cursor-pointer align-middle" />
                    <label for="editCanLogin" class="ml-xs font-label-md text-label-md text-on-surface cursor-pointer select-none align-middle">
                        @L["Volunteers_CanLogin"]
                    </label>
                    <div class="hidden peer-checked:grid grid-cols-2 gap-md mt-sm pt-sm border-t border-outline-variant/20">
                        <div>
                            <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">
                                @L["Volunteers_NewPassword"] @(_volunteer.CanLogin ? L["Volunteers_LeaveBlank"].Value : "*")
                            </label>
                            <input name="NewPassword" type="password" minlength="6"
                                   class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                        </div>
                        <div class="flex items-center">
                            <p class="text-body-sm text-on-surface-variant">
                                @if (_volunteer.CanLogin)
                                { <span>@L["Volunteers_HasExistingPassword"]</span> }
                                else
                                { <span>@L["Volunteers_WillSignIn"]</span> }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <AuthorizeView Roles="Manager">
                        <form method="post" action="/api/volunteers/@Id/delete" class="inline">
                            <AntiforgeryToken />
                            <button type="submit"
                                    class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                                    onclick="return confirm('Delete @(_volunteer.Name.Replace("'", "\\'"))? This cannot be undone.')">
                                @L["Common_Delete"]
                            </button>
                        </form>
                    </AuthorizeView>
                    <div class="flex gap-sm">
                        <a href="/volunteers" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            @L["Common_Cancel"]
                        </a>
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Common_SaveChanges"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Volunteer? _volunteer;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var name = form["Name"].ToString();
            var email = form["Email"].ToString();
            if (!string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(email) && email.Contains('@'))
            {
                var status = Enum.TryParse<VolunteerStatus>(form["Status"].ToString(), out var s) ? s : VolunteerStatus.Active;
                var canLogin = form["CanLogin"].ToString() == "true";
                var newPassword = form["NewPassword"].ToString() is { Length: >= 6 } pw ? pw : null;
                await Api.UpdateVolunteer(new UpdateVolunteer(
                    Id, name, email,
                    form["Phone"].ToString() is { Length: > 0 } ph ? ph : null,
                    form["Role"].ToString() ?? "",
                    form["Notes"].ToString() is { Length: > 0 } n ? n : null,
                    canLogin,
                    status,
                    canLogin ? newPassword : null));
                Nav.NavigateTo("/volunteers");
                return;
            }
        }

        _volunteer = await Api.GetVolunteer(Id);
        if (_volunteer is null) Nav.NavigateTo("/volunteers");
    }
}
