@page "/funds/expenses/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Funds_EditExpense"] – @L["App_Name"]</PageTitle>

@if (_expense is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/funds?tab=expenses" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-secondary">@L["Funds_EditExpense"]</h2>
                <p class="text-body-md text-on-surface-variant">@_expense.Description</p>
            </div>
        </div>

        <!-- Receipt gallery -->
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg mb-md">
            <h3 class="font-label-md text-label-md text-on-surface-variant mb-md">@L["Funds_Receipts"]</h3>

            @if (_photos.Count == 0)
            {
                <p class="text-body-sm text-on-surface-variant mb-md flex items-center gap-xs">
                    <span class="material-symbols-outlined text-base">receipt_long</span> @L["Funds_NoReceipts"]
                </p>
            }
            else
            {
                <div class="grid grid-cols-3 sm:grid-cols-4 gap-sm mb-md">
                    @foreach (var p in _photos)
                    {
                        <div class="relative group rounded-xl overflow-hidden border border-outline-variant/30">
                            <a href="@p.Url" target="_blank" class="block aspect-square bg-surface-container-high">
                                <img src="@p.Url" alt="@_expense.Description" class="w-full h-full object-cover" />
                            </a>
                            <div class="absolute inset-x-0 bottom-0 flex justify-end p-1 bg-gradient-to-t from-black/60 to-transparent">
                                <form method="post" action="/api/expenses/photos/@p.Id/delete?expenseId=@Id" class="inline">
                                    <AntiforgeryToken />
                                    <button type="submit" title="@L["Funds_DeleteReceipt"]"
                                            onclick="return confirm('@L["Funds_DeleteReceiptConfirm"]')"
                                            class="w-7 h-7 flex items-center justify-center rounded-full bg-white/90 text-error hover:bg-white transition-colors">
                                        <span class="material-symbols-outlined text-base">delete</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }

            <form method="post" action="/api/expenses/@Id/photos" enctype="multipart/form-data" class="space-y-sm">
                <input id="receipt-input" type="file" name="Photos" accept=".jpg,.jpeg,.png,.webp" multiple
                       onchange="previewReceipts(this)"
                       class="w-full text-body-sm text-on-surface-variant file:mr-sm file:px-sm file:py-1 file:rounded-lg file:border-0 file:bg-secondary/10 file:text-secondary file:font-label-sm file:cursor-pointer cursor-pointer" />
                <div id="receipt-preview" class="grid grid-cols-3 sm:grid-cols-4 gap-sm hidden"></div>
                <div class="flex items-center justify-between">
                    <p class="text-label-sm text-on-surface-variant">@L["Dogs_PhotoHint"]</p>
                    <button type="submit" class="px-md py-2 bg-secondary text-on-secondary rounded-lg font-label-sm hover:brightness-110 transition-all flex-shrink-0">
                        @L["Funds_AddReceipts"]
                    </button>
                </div>
            </form>
        </div>

        <script>
            function previewReceipts(input) {
                var box = document.getElementById('receipt-preview');
                box.innerHTML = '';
                if (!input.files || input.files.length === 0) { box.classList.add('hidden'); return; }
                box.classList.remove('hidden');
                for (var i = 0; i < input.files.length; i++) {
                    var file = input.files[i];
                    if (!file.type.startsWith('image/')) continue;
                    var img = document.createElement('img');
                    img.className = 'w-full aspect-square object-cover rounded-xl border border-dashed border-secondary/50';
                    img.src = URL.createObjectURL(file);
                    img.onload = function () { URL.revokeObjectURL(this.src); };
                    box.appendChild(img);
                }
            }
        </script>

        @if (_errors.Count > 0)
        {
            <div class="mb-md bg-error-container text-on-error-container rounded-xl p-md space-y-xs">
                @foreach (var e in _errors)
                {
                    <p class="text-body-sm flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">error</span> @e
                    </p>
                }
            </div>
        }

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-expense" @onsubmit="Save" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_DescriptionRequired"]</label>
                        <input name="Description" required value="@_expense.Description"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_AmountRequired"]</label>
                        <input name="Amount" type="number" step="0.01" min="0.01" required value="@_expense.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Category"]</label>
                        <select name="Category" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            @foreach (var cat in Enum.GetValues<ExpenseCategory>())
                            {
                                <option value="@cat" selected="@(cat == _expense.Category)">@L[$"ExpenseCategory_{cat}"]</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                        <input name="Notes" value="@_expense.Notes"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <AuthorizeView Roles="Manager">
                        <button type="submit" formaction="/api/expenses/@Id/delete"
                                class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                                onclick="return confirm('Delete this expense?')">
                            @L["Common_Delete"]
                        </button>
                    </AuthorizeView>
                    <div class="flex gap-sm">
                        <a href="/funds?tab=expenses" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            @L["Common_Cancel"]
                        </a>
                        <button type="submit" class="px-md py-2 bg-secondary text-on-secondary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Common_SaveChanges"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private const string FDescription = "Description";
    private const string FAmount = "Amount";
    private const string FCategory = "Category";
    private const string FNotes = "Notes";

    [Parameter] public int Id { get; set; }

    private ExpenseDto? _expense;
    private List<ExpensePhotoDto> _photos = [];
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        _expense = await Api.GetExpense(Id);
        if (_expense is null) { Nav.NavigateTo("/funds?tab=expenses"); return; }
        _photos = await Api.GetExpensePhotos(Id);
    }

    private async Task Save()
    {
        if (_expense is null) return;
        var form = await HttpContextAccessor.HttpContext!.Request.ReadFormAsync();
        var desc = GetString(form, FDescription);
        var amount = GetDecimal(form, FAmount);

        RequireNotEmpty(_errors, desc, L["Validation_DescriptionRequired"].Value);
        RequirePositive(_errors, amount, L["Validation_AmountPositive"].Value);
        if (_errors.Count > 0) return;

        await Api.UpdateExpense(new UpdateExpenseRequest(
            Id, desc, amount,
            GetEnum(form, FCategory, ExpenseCategory.Other),
            GetStringOrNull(form, FNotes)));
        Nav.NavigateTo("/funds?tab=expenses");
    }
}
