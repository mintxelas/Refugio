@page "/admin/deleted/{type}/{id:int}"
@layout MainLayout
@attribute [Authorize(Policy = "Manager")]
@inject ShelterApiClient Api
@inject NavigationManager Nav

<PageTitle>@L["Admin_DetailTitle"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <div class="flex items-center gap-sm">
        <a href="/admin/deleted?tab=@Type" class="flex items-center gap-xs text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined" style="font-size:20px">arrow_back</span>
            <span class="text-label-md">@L["Admin_BackToList"]</span>
        </a>
    </div>

    @if (_notFound)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-xl text-center">
            <span class="material-symbols-outlined text-5xl text-on-surface-variant block mb-sm">search_off</span>
            <p class="text-body-lg text-on-surface-variant">@L["Admin_NoneDeleted"]</p>
        </div>
    }
    else if (Type == "dogs" && _dog is not null)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30 flex items-center gap-md">
                @if (!string.IsNullOrEmpty(_dog.PhotoUrl))
                {
                    <img src="@_dog.PhotoUrl" alt="@_dog.Name" class="w-16 h-16 rounded-full object-cover" />
                }
                else
                {
                    <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold text-2xl">
                        @_dog.Name.FirstOrDefault()
                    </div>
                }
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">@_dog.Name</h2>
                    <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_dog.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Admin_Breed"]</dt><dd class="text-body-md text-on-surface mt-1">@_dog.Breed</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Status"]</dt><dd class="text-body-md text-on-surface mt-1">@DogStatusDisplay(_dog.Status, L)</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["DogDetail_AgeMonths"]</dt><dd class="text-body-md text-on-surface mt-1">@AgeDisplay(_dog.AgeMonths, L)</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["DogDetail_GenderRequired"]</dt><dd class="text-body-md text-on-surface mt-1">@_dog.Gender</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["DogDetail_WeightKg"]</dt><dd class="text-body-md text-on-surface mt-1">@_dog.WeightKg kg</dd></div>
                @if (!string.IsNullOrEmpty(_dog.Traits))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["DogDetail_Traits"]</dt><dd class="text-body-md text-on-surface mt-1">@_dog.Traits</dd></div>
                }
                @if (!string.IsNullOrEmpty(_dog.Notes))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Notes"]</dt><dd class="text-body-md text-on-surface mt-1">@_dog.Notes</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                <form method="post" action="/api/dogs/@_dog.Id/restore">
                    <AntiforgeryToken />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                        @L["Admin_Restore"]
                    </button>
                </form>
                <form method="post" action="/api/dogs/@_dog.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "adoptions" && _adoption is not null)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30">
                <h2 class="font-headline-md text-headline-md text-on-surface">@_adoption.ApplicantName</h2>
                <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_adoption.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Email"]</dt><dd class="text-body-md text-on-surface mt-1">@(_adoption.ApplicantEmail ?? "—")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Phone"]</dt><dd class="text-body-md text-on-surface mt-1">@(_adoption.ApplicantPhone ?? "—")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Admin_Dog"]</dt><dd class="text-body-md text-on-surface mt-1">@(_adoption.Dog?.Name ?? "—")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Status"]</dt><dd class="text-body-md text-on-surface mt-1">@L[$"Adoptions_{_adoption.Status}"]</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Type"]</dt><dd class="text-body-md text-on-surface mt-1">@(_adoption.Type == AdoptionType.Adoption ? L["Adoptions_Adoption"] : L["Adoptions_Foster"])</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Date"]</dt><dd class="text-body-md text-on-surface mt-1">@_adoption.CreatedAt.ToString("yyyy-MM-dd")</dd></div>
                @if (!string.IsNullOrEmpty(_adoption.Notes))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Notes"]</dt><dd class="text-body-md text-on-surface mt-1">@_adoption.Notes</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                <form method="post" action="/api/adoptions/@_adoption.Id/restore">
                    <AntiforgeryToken />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                        @L["Admin_Restore"]
                    </button>
                </form>
                <form method="post" action="/api/adoptions/@_adoption.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "volunteers" && _volunteer is not null)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30 flex items-center gap-md">
                <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold text-2xl">
                    @string.Concat(_volunteer.Name.Split(' ').Take(2).Select(w => w.FirstOrDefault()))
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">@_volunteer.Name</h2>
                    <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_volunteer.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Email"]</dt><dd class="text-body-md text-on-surface mt-1">@_volunteer.Email</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Phone"]</dt><dd class="text-body-md text-on-surface mt-1">@(_volunteer.Phone ?? "—")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Role"]</dt><dd class="text-body-md text-on-surface mt-1">@_volunteer.Role</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Status"]</dt><dd class="text-body-md text-on-surface mt-1">@L[$"VolunteerStatus_{_volunteer.Status}"]</dd></div>
                @if (!string.IsNullOrEmpty(_volunteer.Notes))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Notes"]</dt><dd class="text-body-md text-on-surface mt-1">@_volunteer.Notes</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                <form method="post" action="/api/volunteers/@_volunteer.Id/restore">
                    <AntiforgeryToken />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                        @L["Admin_Restore"]
                    </button>
                </form>
                <form method="post" action="/api/volunteers/@_volunteer.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "donations" && _donation is not null)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30">
                <h2 class="font-headline-md text-headline-md text-on-surface">@_donation.DonorName</h2>
                <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_donation.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Amount"]</dt><dd class="text-body-md font-bold text-primary mt-1">€@_donation.Amount.ToString("F2")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Category"]</dt><dd class="text-body-md text-on-surface mt-1">@L[$"DonationCategory_{_donation.Category}"]</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Date"]</dt><dd class="text-body-md text-on-surface mt-1">@_donation.Date.ToString("yyyy-MM-dd")</dd></div>
                @if (!string.IsNullOrEmpty(_donation.Notes))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Notes"]</dt><dd class="text-body-md text-on-surface mt-1">@_donation.Notes</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                <form method="post" action="/api/donations/@_donation.Id/restore">
                    <AntiforgeryToken />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                        @L["Admin_Restore"]
                    </button>
                </form>
                <form method="post" action="/api/donations/@_donation.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "expenses" && _expense is not null)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30">
                <h2 class="font-headline-md text-headline-md text-on-surface">@_expense.Description</h2>
                <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_expense.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Amount"]</dt><dd class="text-body-md font-bold text-secondary mt-1">€@_expense.Amount.ToString("F2")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Category"]</dt><dd class="text-body-md text-on-surface mt-1">@L[$"ExpenseCategory_{_expense.Category}"]</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Date"]</dt><dd class="text-body-md text-on-surface mt-1">@_expense.Date.ToString("yyyy-MM-dd")</dd></div>
                @if (!string.IsNullOrEmpty(_expense.Notes))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Notes"]</dt><dd class="text-body-md text-on-surface mt-1">@_expense.Notes</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                <form method="post" action="/api/expenses/@_expense.Id/restore">
                    <AntiforgeryToken />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                        @L["Admin_Restore"]
                    </button>
                </form>
                <form method="post" action="/api/expenses/@_expense.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "goals" && _goal is not null)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30">
                <h2 class="font-headline-md text-headline-md text-on-surface">@_goal.Title</h2>
                <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_goal.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Goals_TargetAmount"]</dt><dd class="text-body-md font-bold text-tertiary mt-1">€@_goal.TargetAmount.ToString("F2")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Goals_CurrentAmount"]</dt><dd class="text-body-md text-on-surface mt-1">€@_goal.CurrentAmount.ToString("F2")</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Goals_Deadline"]</dt><dd class="text-body-md text-on-surface mt-1">@(_goal.Deadline.HasValue ? _goal.Deadline.Value.ToString("yyyy-MM-dd") : L["Goals_NoDeadline"].Value)</dd></div>
                @if (!string.IsNullOrEmpty(_goal.Description))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Description"]</dt><dd class="text-body-md text-on-surface mt-1">@_goal.Description</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                <form method="post" action="/api/goals/@_goal.Id/restore">
                    <AntiforgeryToken />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                        @L["Admin_Restore"]
                    </button>
                </form>
                <form method="post" action="/api/goals/@_goal.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "medical" && _medicalRecord is not null)
    {
        var dogDeleted = _medicalRecord.Dog?.DeletedAt != null;
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30">
                <div class="flex items-center gap-sm">
                    @if (dogDeleted)
                    {
                        <span class="material-symbols-outlined text-error" title="@L["Admin_ParentDogDeleted"]">warning</span>
                    }
                    <div>
                        <h2 class="font-headline-md text-headline-md text-on-surface">@_medicalRecord.Diagnosis</h2>
                        <p class="text-body-sm @(dogDeleted ? "text-error" : "text-on-surface-variant")">
                            @L["Admin_Dog"]: @(_medicalRecord.Dog?.Name ?? "—")
                            @if (dogDeleted) { <span> — @L["Admin_ParentDogDeleted"]</span> }
                        </p>
                        <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_medicalRecord.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                    </div>
                </div>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_VetName"]</dt><dd class="text-body-md text-on-surface mt-1">@_medicalRecord.VetName</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Date"]</dt><dd class="text-body-md text-on-surface mt-1">@_medicalRecord.VisitDate.ToString("yyyy-MM-dd")</dd></div>
                <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_Treatment"]</dt><dd class="text-body-md text-on-surface mt-1">@_medicalRecord.Treatment</dd></div>
                @if (_medicalRecord.NextVisitDate.HasValue)
                {
                    <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_NextVisit"]</dt><dd class="text-body-md text-on-surface mt-1">@_medicalRecord.NextVisitDate.Value.ToString("yyyy-MM-dd")</dd></div>
                }
                @if (!string.IsNullOrEmpty(_medicalRecord.Notes))
                {
                    <div class="col-span-2"><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Common_Notes"]</dt><dd class="text-body-md text-on-surface mt-1">@_medicalRecord.Notes</dd></div>
                }
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                @if (!dogDeleted)
                {
                    <form method="post" action="/api/medical/@_medicalRecord.Id/restore">
                        <AntiforgeryToken />
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                            @L["Admin_Restore"]
                        </button>
                    </form>
                }
                else
                {
                    <span class="px-md py-2 rounded-lg text-label-md text-on-surface-variant/50 bg-surface-container cursor-not-allowed" title="@L["Admin_ParentDogDeleted"]">
                        @L["Admin_Restore"]
                    </span>
                }
                <form method="post" action="/api/medical/@_medicalRecord.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Type == "medications" && _medication is not null)
    {
        var dogDeleted = _medication.Dog?.DeletedAt != null;
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="px-xl py-lg border-b border-outline-variant/30">
                <div class="flex items-center gap-sm">
                    @if (dogDeleted)
                    {
                        <span class="material-symbols-outlined text-error" title="@L["Admin_ParentDogDeleted"]">warning</span>
                    }
                    <div>
                        <h2 class="font-headline-md text-headline-md text-on-surface">@_medication.Name</h2>
                        <p class="text-body-sm @(dogDeleted ? "text-error" : "text-on-surface-variant")">
                            @L["Admin_Dog"]: @(_medication.Dog?.Name ?? "—")
                            @if (dogDeleted) { <span> — @L["Admin_ParentDogDeleted"]</span> }
                        </p>
                        <p class="text-body-sm text-error">@L["Admin_DeletedOn"]: @_medication.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                    </div>
                </div>
            </div>
            <dl class="grid grid-cols-2 gap-x-xl gap-y-md px-xl py-lg">
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_Dosage"]</dt><dd class="text-body-md text-on-surface mt-1">@_medication.Dosage</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_Frequency"]</dt><dd class="text-body-md text-on-surface mt-1">@_medication.Frequency</dd></div>
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_StartDate"]</dt><dd class="text-body-md text-on-surface mt-1">@_medication.StartDate.ToString("yyyy-MM-dd")</dd></div>
                @if (_medication.EndDate.HasValue)
                {
                    <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_EndDate"]</dt><dd class="text-body-md text-on-surface mt-1">@_medication.EndDate.Value.ToString("yyyy-MM-dd")</dd></div>
                }
                <div><dt class="text-label-sm text-on-surface-variant uppercase tracking-wide">@L["Health_IsActive"]</dt><dd class="text-body-md text-on-surface mt-1">@(_medication.IsActive ? L["Health_MedActive"] : L["Health_MedCompleted"])</dd></div>
            </dl>
            <div class="px-xl py-lg border-t border-outline-variant/30 flex gap-sm justify-end">
                @if (!dogDeleted)
                {
                    <form method="post" action="/api/medications/@_medication.Id/restore">
                        <AntiforgeryToken />
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all">
                            @L["Admin_Restore"]
                        </button>
                    </form>
                }
                else
                {
                    <span class="px-md py-2 rounded-lg text-label-md text-on-surface-variant/50 bg-surface-container cursor-not-allowed" title="@L["Admin_ParentDogDeleted"]">
                        @L["Admin_Restore"]
                    </span>
                }
                <form method="post" action="/api/medications/@_medication.Id/purge">
                    <AntiforgeryToken />
                    <button type="submit" onclick="return confirm('@L["Admin_PermanentDeleteConfirm"].Value')"
                            class="px-md py-2 bg-error text-on-error rounded-lg font-label-md hover:bg-error/90 transition-all">
                        @L["Admin_PermanentDelete"]
                    </button>
                </form>
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public int Id { get; set; }

    private bool _notFound;
    private DogDto? _dog;
    private AdoptionDto? _adoption;
    private VolunteerDto? _volunteer;
    private DonationDto? _donation;
    private ExpenseDto? _expense;
    private MedicalRecordDto? _medicalRecord;
    private MedicationDto? _medication;
    private GoalDto? _goal;

    protected override async Task OnInitializedAsync()
    {
        switch (Type)
        {
            case "dogs":
                _dog = await Api.GetDeletedDogById(Id);
                _notFound = _dog is null;
                break;
            case "adoptions":
                _adoption = await Api.GetDeletedAdoptionById(Id);
                _notFound = _adoption is null;
                break;
            case "volunteers":
                _volunteer = await Api.GetDeletedVolunteerById(Id);
                _notFound = _volunteer is null;
                break;
            case "donations":
                _donation = await Api.GetDeletedDonationById(Id);
                _notFound = _donation is null;
                break;
            case "expenses":
                _expense = await Api.GetDeletedExpenseById(Id);
                _notFound = _expense is null;
                break;
            case "medical":
                _medicalRecord = await Api.GetDeletedMedicalRecordById(Id);
                _notFound = _medicalRecord is null;
                break;
            case "medications":
                _medication = await Api.GetDeletedMedicationById(Id);
                _notFound = _medication is null;
                break;
            case "goals":
                _goal = await Api.GetDeletedGoalById(Id);
                _notFound = _goal is null;
                break;
            default:
                _notFound = true;
                break;
        }
    }
}
