@page "/dogs"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api

<PageTitle>@L["Nav_Dogs"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-primary">@L["Dogs_Title"]</h2>
            <p class="text-body-md text-on-surface-variant">@L["Dogs_Subtitle"]</p>
        </div>
        <a href="/dogs/new" class="px-md py-3 bg-primary text-on-primary rounded-lg font-label-md flex items-center gap-sm hover:brightness-110 transition-all">
            <span class="material-symbols-outlined">add</span> @L["Common_CheckInAnimal"]
        </a>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-sm items-center">
        <form method="get" action="/dogs" class="relative">
            @if (!string.IsNullOrEmpty(StatusParam))
            {
                <input type="hidden" name="status" value="@StatusParam" />
            }
            <input name="search" value="@Search"
                   placeholder="@L["Dogs_SearchPlaceholder"]"
                   class="pl-4 pr-4 py-2 bg-surface-container-high border-none rounded-full text-body-sm focus:ring-2 focus:ring-primary w-72 transition-all" />
        </form>
        <div class="flex gap-xs">
            @foreach (var s in Enum.GetValues<DogStatus>())
            {
                var isActive = StatusParam == s.ToString();
                <a href="/dogs?@(string.IsNullOrEmpty(Search) ? "" : $"search={Uri.EscapeDataString(Search)}&")status=@s"
                   class="px-sm py-1 rounded-full text-label-sm font-label-sm border transition-all @(isActive ? "bg-primary text-on-primary border-primary" : "border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary")">
                    @DogStatusDisplay(s, L)
                </a>
            }
            <a href="@(string.IsNullOrEmpty(Search) ? "/dogs" : $"/dogs?search={Uri.EscapeDataString(Search)}")"
               class="px-sm py-1 rounded-full text-label-sm font-label-sm border transition-all @(string.IsNullOrEmpty(StatusParam) ? "bg-primary text-on-primary border-primary" : "border-outline-variant text-on-surface-variant")">
                @L["Common_All"]
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-gutter">
        @foreach (var dog in _dogs)
        {
            <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden flex flex-col group hover:shadow-lg transition-all">
                <div class="relative h-44 bg-surface-container-high flex items-center justify-center overflow-hidden">
                    @if (!string.IsNullOrEmpty(dog.PhotoUrl))
                    {
                        <img src="@dog.PhotoUrl" alt="@dog.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-primary-fixed-dim text-7xl group-hover:scale-110 transition-transform duration-500" style="font-variation-settings:'FILL' 1">pets</span>
                    }
                    <div class="absolute top-sm right-sm">
                        <span class="@StatusChipClass(dog.Status) px-sm py-1 rounded-full text-label-sm font-label-sm flex items-center gap-xs shadow-md">
                            <span class="material-symbols-outlined text-sm">@StatusIcon(dog.Status)</span>
                            @DogStatusDisplay(dog.Status, L)
                        </span>
                    </div>
                </div>
                <div class="p-md space-y-sm flex-1 flex flex-col">
                    <div>
                        <h4 class="font-headline-md text-headline-md text-on-surface">@dog.Name</h4>
                        <p class="text-body-sm text-on-surface-variant">@AgeDisplay(dog.AgeMonths, L) • @dog.Breed • @dog.Gender</p>
                    </div>
                    @if (!string.IsNullOrEmpty(dog.Traits))
                    {
                        <div class="flex flex-wrap gap-xs">
                            @foreach (var tag in dog.Traits.Split(',').Take(3))
                            {
                                <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-label-sm">@tag.Trim()</span>
                            }
                        </div>
                    }
                    <div class="mt-auto pt-sm border-t border-outline-variant/30 flex gap-sm">
                        <a href="/dogs/@dog.Id" class="flex-1 bg-primary text-on-primary py-2 rounded-lg font-label-md text-label-md text-center hover:brightness-110 transition-all">
                            @L["Common_ViewProfile"]
                        </a>
                        <a href="/dogs/@dog.Id/edit" class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all" title="@L["Common_Edit"]">
                            <span class="material-symbols-outlined">edit</span>
                        </a>
                        <form method="post" action="/api/dogs/@dog.Id/delete" class="contents">
                            <AntiforgeryToken />
                            <button type="submit"
                                    class="w-10 h-10 flex items-center justify-center rounded-lg border border-error/40 text-error hover:bg-error-container/20 transition-all"
                                    title="@L["Common_Delete"]"
                                    onclick="return confirm('@L["Common_Delete"] @dog.Name?')">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </form>
                        <a href="/health?dogId=@dog.Id" class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all">
                            <span class="material-symbols-outlined">medical_services</span>
                        </a>
                    </div>
                </div>
            </div>
        }
        <a href="/dogs/new" class="border-2 border-dashed border-outline-variant rounded-xl flex flex-col items-center justify-center p-md group hover:border-primary hover:bg-primary-container/5 transition-all min-h-[280px]">
            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mb-md group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-primary text-4xl">add</span>
            </div>
            <p class="font-label-md text-on-surface-variant group-hover:text-primary">@L["Common_AddNewAnimal"]</p>
        </a>
    </div>

    @if (!_dogs.Any())
    {
        <div class="text-center py-16 text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-4 block">search</span>
            <p class="text-body-lg">@L["Dogs_NoResults"]</p>
        </div>
    }

    @if (_totalPages > 1)
    {
        <div class="flex items-center justify-between pt-sm">
            <p class="text-body-sm text-on-surface-variant">
                @string.Format(L["Common_Showing"].Value, FirstItem, LastItem, _totalCount)
            </p>
            <div class="flex items-center gap-sm">
                @if (CurrentPage > 1)
                {
                    <a href="@PageUrl(CurrentPage - 1)"
                       class="px-md py-2 rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container transition-colors flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">chevron_left</span>
                        @L["Common_PrevPage"]
                    </a>
                }
                <div class="flex gap-xs">
                    @foreach (var p in PageNumbers())
                    {
                        @if (p == 0)
                        {
                            <span class="px-sm py-2 text-on-surface-variant text-label-sm">…</span>
                        }
                        else
                        {
                            <a href="@PageUrl(p)"
                               class="w-9 h-9 flex items-center justify-center rounded-lg text-label-md font-label-md transition-colors @(p == CurrentPage ? "bg-primary text-on-primary" : "border border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                                @p
                            </a>
                        }
                    }
                </div>
                @if (CurrentPage < _totalPages)
                {
                    <a href="@PageUrl(CurrentPage + 1)"
                       class="px-md py-2 rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container transition-colors flex items-center gap-xs">
                        @L["Common_NextPage"]
                        <span class="material-symbols-outlined text-base">chevron_right</span>
                    </a>
                }
            </div>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "search")] private string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "status")] private string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "page")]   private int PageParam { get; set; } = 1;

    private List<Dog> _dogs = [];
    private int _totalCount;
    private int _totalPages;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        DogStatus? status = Enum.TryParse<DogStatus>(StatusParam, out var s) ? s : null;
        var page = PageParam < 1 ? 1 : PageParam;
        var result = await Api.GetDogsPaged(Search, status, page, PageSize);
        _dogs = result.Items;
        _totalCount = result.TotalCount;
        _totalPages = (int)Math.Ceiling((double)_totalCount / PageSize);
    }

    private string PageUrl(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(Search))  parts.Add($"search={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrEmpty(StatusParam)) parts.Add($"status={Uri.EscapeDataString(StatusParam)}");
        if (page > 1) parts.Add($"page={page}");
        return "/dogs" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }

    private int CurrentPage => PageParam < 1 ? 1 : PageParam;
    private int FirstItem => _totalCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int LastItem  => Math.Min(CurrentPage * PageSize, _totalCount);

    private IEnumerable<int> PageNumbers()
    {
        var pages = new List<int>();
        for (var p = 1; p <= _totalPages; p++)
        {
            if (p == 1 || p == _totalPages || Math.Abs(p - CurrentPage) <= 2)
                pages.Add(p);
        }
        var result = new List<int>();
        int? prev = null;
        foreach (var p in pages)
        {
            if (prev.HasValue && p - prev.Value > 1) result.Add(0); // ellipsis sentinel
            result.Add(p);
            prev = p;
        }
        return result;
    }

}
