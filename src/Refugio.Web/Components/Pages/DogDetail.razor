@page "/dogs/{Id:int}"
@page "/dogs/new"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_dog?.Name ?? "New Dog") – Haven Sanctuary</PageTitle>

@if (_loading)
{
    <div class="flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else if (IsNew)
{
    <!-- Create form -->
    <section class="p-margin-desktop max-w-2xl mx-auto space-y-lg">
        <div>
            <a href="/dogs" class="text-primary flex items-center gap-xs hover:underline font-label-md mb-md inline-flex">
                <span class="material-symbols-outlined text-base">arrow_back</span> Back to Dogs
            </a>
            <h2 class="font-headline-xl text-headline-xl text-primary">Check-in New Animal</h2>
        </div>
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md space-y-md">
            <div class="grid grid-cols-2 gap-md">
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Name *</label>
                    <input @bind="_form.Name" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Breed *</label>
                    <input @bind="_form.Breed" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Age (months) *</label>
                    <input @bind="_form.AgeMonths" type="number" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Gender *</label>
                    <select @bind="_form.Gender" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Weight (kg)</label>
                    <input @bind="_form.WeightKg" type="number" step="0.1" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Traits (comma separated)</label>
                    <input @bind="_form.Traits" placeholder="Friendly, Trained, Kid Friendly" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Notes</label>
                <textarea @bind="_form.Notes" rows="3" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary"></textarea>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="text-error text-body-sm">@_error</p>
            }
            <div class="flex gap-sm justify-end">
                <a href="/dogs" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high font-label-md">Cancel</a>
                <button @onclick="Save" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">Check-in Animal</button>
            </div>
        </div>
    </section>
}
else if (_dog is not null)
{
    <section class="p-margin-desktop max-w-screen-lg mx-auto space-y-lg">
        <div class="flex items-start justify-between">
            <div>
                <a href="/dogs" class="text-primary flex items-center gap-xs hover:underline font-label-md mb-md inline-flex">
                    <span class="material-symbols-outlined text-base">arrow_back</span> Back to Dogs
                </a>
                <h2 class="font-headline-xl text-headline-xl text-primary">@_dog.Name</h2>
                <p class="text-body-lg text-on-surface-variant">@AgeDisplay(_dog.AgeMonths) • @_dog.Breed • @_dog.Gender • @_dog.WeightKg kg</p>
            </div>
            <span class="@StatusChipClass(_dog.Status) px-md py-2 rounded-full font-label-md flex items-center gap-xs">
                <span class="material-symbols-outlined text-base">@StatusIcon(_dog.Status)</span>
                @_dog.Status
            </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
            <!-- Left: Dog info -->
            <div class="space-y-md">
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <div class="h-48 bg-surface-container-high rounded-lg flex items-center justify-center mb-md">
                        <span class="material-symbols-outlined text-primary-fixed-dim text-8xl" style="font-variation-settings:'FILL' 1">pets</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_dog.Traits))
                    {
                        <div class="flex flex-wrap gap-xs mb-md">
                            @foreach (var tag in _dog.Traits.Split(','))
                            {
                                <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-label-sm">@tag.Trim()</span>
                            }
                        </div>
                    }
                    <div class="space-y-xs text-body-sm text-on-surface-variant">
                        <p><span class="font-semibold text-on-surface">Arrived:</span> @_dog.ArrivalDate.ToString("MMM d, yyyy")</p>
                        @if (!string.IsNullOrEmpty(_dog.Notes))
                        {
                            <p><span class="font-semibold text-on-surface">Notes:</span> @_dog.Notes</p>
                        }
                    </div>
                    <div class="mt-md flex gap-sm">
                        <a href="/adoptions?dogId=@_dog.Id" class="flex-1 text-center py-2 bg-secondary text-on-secondary rounded-lg font-label-md hover:brightness-110 transition-all">Start Adoption</a>
                        <a href="/health?dogId=@_dog.Id" class="flex-1 text-center py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">Health Record</a>
                    </div>
                </div>
            </div>

            <!-- Right: Medical history and meds -->
            <div class="lg:col-span-2 space-y-md">
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">Medical History</h3>
                    @if (!_records.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant">No medical records yet.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var rec in _records)
                            {
                                <div class="py-sm">
                                    <div class="flex justify-between items-start">
                                        <h4 class="font-label-md text-on-surface">@rec.Diagnosis</h4>
                                        <span class="text-body-sm text-on-surface-variant">@rec.VisitDate.ToString("MMM d, yyyy")</span>
                                    </div>
                                    <p class="text-body-sm text-on-surface-variant">@rec.VetName • @rec.Treatment</p>
                                    @if (rec.NextVisitDate.HasValue)
                                    {
                                        <p class="text-label-sm text-primary">Next: @rec.NextVisitDate.Value.ToString("MMM d, yyyy")</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">Active Medications</h3>
                    @if (!_medications.Any(m => m.IsActive))
                    {
                        <p class="text-body-sm text-on-surface-variant">No active medications.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var med in _medications.Where(m => m.IsActive))
                            {
                                <div class="py-sm flex justify-between items-center">
                                    <div>
                                        <p class="font-label-md text-on-surface">@med.Name</p>
                                        <p class="text-body-sm text-on-surface-variant">@med.Dosage • @med.Frequency</p>
                                    </div>
                                    @if (med.EndDate.HasValue)
                                    {
                                        <span class="text-label-sm @(med.EndDate < DateTime.UtcNow.AddDays(3) ? "text-error" : "text-on-surface-variant")">
                                            Until @med.EndDate.Value.ToString("MMM d")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private Dog? _dog;
    private List<MedicalRecord> _records = [];
    private List<Medication> _medications = [];
    private string? _error;

    private bool IsNew => Id == 0;

    private class DogForm
    {
        public string Name { get; set; } = "";
        public string Breed { get; set; } = "";
        public int AgeMonths { get; set; } = 12;
        public string Gender { get; set; } = "Male";
        public decimal WeightKg { get; set; }
        public string? Traits { get; set; }
        public string? Notes { get; set; }
    }

    private DogForm _form = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        if (!IsNew)
        {
            _dog = await Api.GetDog(Id);
            if (_dog is not null)
            {
                _records = await Api.GetMedicalRecords(Id);
                _medications = await Api.GetMedications(Id);
            }
        }
        _loading = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Breed))
        {
            _error = "Name and Breed are required.";
            return;
        }
        var dog = await Api.CreateDog(new CreateDog(_form.Name, _form.Breed, _form.AgeMonths, _form.Gender, _form.WeightKg, null, _form.Traits, _form.Notes));
        Nav.NavigateTo($"/dogs/{dog.Id}");
    }

    private string StatusChipClass(DogStatus s) => s switch
    {
        DogStatus.Medical => "bg-error text-on-error",
        DogStatus.Adopted => "bg-secondary-container text-on-secondary-container",
        DogStatus.Foster => "bg-secondary-fixed text-on-secondary-fixed",
        _ => "bg-primary-fixed text-on-primary-fixed"
    };

    private string StatusIcon(DogStatus s) => s switch
    {
        DogStatus.Medical => "medical_services",
        DogStatus.Adopted => "favorite",
        DogStatus.Foster => "home",
        _ => "pets"
    };

    private string AgeDisplay(int months) =>
        months >= 12 ? $"{months / 12} year{(months / 12 > 1 ? "s" : "")}" : $"{months} months";
}
