@page "/dogs/{Id:int}"
@page "/dogs/new"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_dog?.Name ?? L["DogDetail_CheckInTitle"].Value) – @L["App_Name"]</PageTitle>

@if (_loading)
{
    <div class="flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else if (IsNew)
{
    <section class="p-margin-desktop max-w-2xl mx-auto space-y-lg">
        <div>
            <a href="/dogs" class="text-primary flex items-center gap-xs hover:underline font-label-md mb-md inline-flex">
                <span class="material-symbols-outlined text-base">arrow_back</span> @L["Common_BackToDogs"]
            </a>
            <h2 class="font-headline-xl text-headline-xl text-primary">@L["DogDetail_CheckInTitle"]</h2>
        </div>
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md space-y-md">
            <form method="post" @formname="new-dog" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_NameRequired"]</label>
                        <input name="Name" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_BreedRequired"]</label>
                        <input name="Breed" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_AgeMonths"]</label>
                        <input name="AgeMonths" type="number" min="1" required value="12" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_GenderRequired"]</label>
                        <select name="Gender" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary bg-white">
                            <option value="Male">@L["DogDetail_Male"]</option>
                            <option value="Female">@L["DogDetail_Female"]</option>
                        </select>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_WeightKg"]</label>
                        <input name="WeightKg" type="number" step="0.1" value="0" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_Traits"]</label>
                        <input name="Traits" placeholder="@L["DogDetail_TraitsPlaceholder"]" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                    <textarea name="Notes" rows="3" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="text-error text-body-sm">@_error</p>
                }
                <div class="flex gap-sm justify-end">
                    <a href="/dogs" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high font-label-md">@L["Common_Cancel"]</a>
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">@L["Common_CheckInAnimal"]</button>
                </div>
            </form>
        </div>
    </section>
}
else if (_dog is not null)
{
    <section class="p-margin-desktop max-w-screen-lg mx-auto space-y-lg">
        <div class="flex items-start justify-between">
            <div>
                <a href="/dogs" class="text-primary flex items-center gap-xs hover:underline font-label-md mb-md inline-flex">
                    <span class="material-symbols-outlined text-base">arrow_back</span> @L["Common_BackToDogs"]
                </a>
                <h2 class="font-headline-xl text-headline-xl text-primary">@_dog.Name</h2>
                <p class="text-body-lg text-on-surface-variant">@AgeDisplay(_dog.AgeMonths) • @_dog.Breed • @_dog.Gender • @_dog.WeightKg kg</p>
            </div>
            <div class="flex items-center gap-sm">
                <a href="/api/dogs/@_dog.Id/delete"
                   class="flex items-center gap-xs px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-all"
                   onclick="return confirm('@L["Common_Delete"] @(_dog.Name)?')">
                    <span class="material-symbols-outlined text-base">delete</span>
                    @L["Common_Delete"]
                </a>
                <a href="/dogs/@_dog.Id/edit" class="flex items-center gap-xs px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container-high transition-all">
                    <span class="material-symbols-outlined text-base">edit</span>
                    @L["Common_Edit"]
                </a>
                <span class="@StatusChipClass(_dog.Status) px-md py-2 rounded-full font-label-md flex items-center gap-xs">
                    <span class="material-symbols-outlined text-base">@StatusIcon(_dog.Status)</span>
                    @DogStatusDisplay(_dog.Status)
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
            <div class="space-y-md">
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <div class="h-48 bg-surface-container-high rounded-lg flex items-center justify-center mb-md overflow-hidden">
                        @if (!string.IsNullOrEmpty(_dog.PhotoUrl))
                        {
                            <img src="@_dog.PhotoUrl" alt="@_dog.Name" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-primary-fixed-dim text-8xl" style="font-variation-settings:'FILL' 1">pets</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_dog.Traits))
                    {
                        <div class="flex flex-wrap gap-xs mb-md">
                            @foreach (var tag in _dog.Traits.Split(','))
                            {
                                <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-label-sm">@tag.Trim()</span>
                            }
                        </div>
                    }
                    <div class="space-y-xs text-body-sm text-on-surface-variant">
                        <p><span class="font-semibold text-on-surface">@L["DogDetail_Arrived"]</span> @_dog.ArrivalDate.ToString("MMM d, yyyy")</p>
                        @if (!string.IsNullOrEmpty(_dog.Notes))
                        {
                            <p><span class="font-semibold text-on-surface">@L["DogDetail_NotesLabel"]</span> @_dog.Notes</p>
                        }
                    </div>
                    <div class="mt-md flex gap-sm">
                        <a href="/adoptions?dogId=@_dog.Id" class="flex-1 text-center py-2 bg-secondary text-on-secondary rounded-lg font-label-md hover:brightness-110 transition-all">@L["DogDetail_StartAdoption"]</a>
                        <a href="/health?dogId=@_dog.Id" class="flex-1 text-center py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">@L["DogDetail_HealthRecord"]</a>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-md">
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">@L["DogDetail_MedicalHistory"]</h3>
                    @if (!_records.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant">@L["DogDetail_NoMedicalRecords"]</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var rec in _records)
                            {
                                <div class="py-sm">
                                    <div class="flex justify-between items-start gap-sm">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex justify-between items-start">
                                                <h4 class="font-label-md text-on-surface">@rec.Diagnosis</h4>
                                                <span class="text-body-sm text-on-surface-variant flex-shrink-0 ml-sm">@rec.VisitDate.ToString("MMM d, yyyy")</span>
                                            </div>
                                            <p class="text-body-sm text-on-surface-variant">@rec.VetName • @rec.Treatment</p>
                                            @if (rec.NextVisitDate.HasValue)
                                            {
                                                <p class="text-label-sm text-primary">@L["DogDetail_Next"] @rec.NextVisitDate.Value.ToString("MMM d, yyyy")</p>
                                            }
                                        </div>
                                        <div class="flex gap-xs flex-shrink-0">
                                            <a href="/dogs/@_dog.Id/medical/@rec.Id" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all" title="@L["Common_Edit"]">
                                                <span class="material-symbols-outlined text-sm">edit</span>
                                            </a>
                                            <a href="/api/medical/@rec.Id/delete?dogId=@_dog.Id"
                                               class="w-8 h-8 flex items-center justify-center rounded-lg border border-error/40 text-error hover:bg-error-container/20 transition-all"
                                               title="@L["Common_Delete"]"
                                               onclick="return confirm('@L["Common_Delete"]?')">
                                                <span class="material-symbols-outlined text-sm">delete</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">@L["DogDetail_ActiveMedications"]</h3>
                    @if (!_medications.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant">@L["DogDetail_NoActiveMedications"]</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var med in _medications)
                            {
                                <div class="py-sm flex justify-between items-center gap-sm">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-xs">
                                            <p class="font-label-md text-on-surface">@med.Name</p>
                                            @if (!med.IsActive)
                                            {
                                                <span class="text-label-sm text-on-surface-variant bg-surface-container-high px-xs py-0.5 rounded-full">@L["Health_MedCompleted"]</span>
                                            }
                                        </div>
                                        <p class="text-body-sm text-on-surface-variant">@med.Dosage • @med.Frequency</p>
                                        @if (med.EndDate.HasValue)
                                        {
                                            <span class="text-label-sm @(med.IsActive && med.EndDate < DateTime.UtcNow.AddDays(3) ? "text-error" : "text-on-surface-variant")">
                                                @string.Format(L["DogDetail_Until"].Value, med.EndDate.Value.ToString("MMM d"))
                                            </span>
                                        }
                                    </div>
                                    <div class="flex gap-xs flex-shrink-0">
                                        <a href="/dogs/@_dog.Id/medications/@med.Id" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all" title="@L["Common_Edit"]">
                                            <span class="material-symbols-outlined text-sm">edit</span>
                                        </a>
                                        <a href="/api/medications/@med.Id/delete?dogId=@_dog.Id"
                                           class="w-8 h-8 flex items-center justify-center rounded-lg border border-error/40 text-error hover:bg-error-container/20 transition-all"
                                           title="@L["Common_Delete"]"
                                           onclick="return confirm('@L["Common_Delete"]?')">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private Dog? _dog;
    private List<MedicalRecord> _records = [];
    private List<Medication> _medications = [];
    private string? _error;

    private bool IsNew => Id == 0;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (IsNew && ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var name = form["Name"].ToString();
            var breed = form["Breed"].ToString();
            if (!string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(breed))
            {
                int.TryParse(form["AgeMonths"].ToString(), out var age);
                decimal.TryParse(form["WeightKg"].ToString(), out var weight);
                var dog = await Api.CreateDog(new CreateDog(
                    name,
                    breed,
                    age > 0 ? age : 12,
                    form["Gender"].ToString() is "Female" ? "Female" : "Male",
                    weight,
                    null,
                    form["Traits"].ToString() is { Length: > 0 } t ? t : null,
                    form["Notes"].ToString() is { Length: > 0 } n ? n : null));
                Nav.NavigateTo($"/dogs/{dog.Id}");
                return;
            }
            _error = L["DogDetail_NameBreedRequired"].Value;
        }

        if (!IsNew)
        {
            _dog = await Api.GetDog(Id);
            if (_dog is not null)
            {
                _records = await Api.GetMedicalRecords(Id);
                _medications = await Api.GetMedications(Id);
            }
        }
        _loading = false;
    }

    private string StatusChipClass(DogStatus s) => s switch
    {
        DogStatus.Medical => "bg-error text-on-error",
        DogStatus.Adopted => "bg-secondary-container text-on-secondary-container",
        DogStatus.Foster => "bg-secondary-fixed text-on-secondary-fixed",
        _ => "bg-primary-fixed text-on-primary-fixed"
    };

    private string StatusIcon(DogStatus s) => s switch
    {
        DogStatus.Medical => "medical_services",
        DogStatus.Adopted => "favorite",
        DogStatus.Foster => "home",
        _ => "pets"
    };

    private string DogStatusDisplay(DogStatus s) => s switch
    {
        DogStatus.Medical    => L["DogStatus_Medical"].Value,
        DogStatus.Available  => L["DogStatus_Available"].Value,
        DogStatus.Adopted    => L["DogStatus_Adopted"].Value,
        DogStatus.Foster     => L["DogStatus_Foster"].Value,
        DogStatus.Quarantine => L["DogStatus_Quarantine"].Value,
        _                    => s.ToString()
    };

    private string AgeDisplay(int months)
    {
        if (months >= 12)
        {
            var years = months / 12;
            return string.Format(years > 1 ? L["DogDetail_Years"].Value : L["DogDetail_Year"].Value, years);
        }
        return string.Format(L["DogDetail_Months"].Value, months);
    }
}
