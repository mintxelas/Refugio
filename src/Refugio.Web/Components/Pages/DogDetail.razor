@page "/dogs/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api

<PageTitle>@(_dog?.Name ?? L["DogDetail_CheckInTitle"].Value) – @L["App_Name"]</PageTitle>

@if (_loading)
{
    <div class="flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else if (_dog is not null)
{
    <section class="p-margin-desktop max-w-screen-lg mx-auto space-y-lg">
        <div class="flex items-start justify-between">
            <div>
                <a href="/dogs" class="text-primary flex items-center gap-xs hover:underline font-label-md mb-md inline-flex">
                    <span class="material-symbols-outlined text-base">arrow_back</span> @L["Common_BackToDogs"]
                </a>
                <h2 class="font-headline-xl text-headline-xl text-primary">@_dog.Name</h2>
                <p class="text-body-lg text-on-surface-variant">@AgeDisplay(_dog.AgeMonths, L) • @_dog.Breed • @_dog.Gender • @_dog.WeightKg kg</p>
            </div>
            <div class="flex items-center gap-sm">
                <AuthorizeView Roles="Manager">
                    <form method="post" action="/api/dogs/@_dog.Id/delete" class="inline">
                        <AntiforgeryToken />
                        <button type="submit"
                                class="flex items-center gap-xs px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-all"
                                onclick="return confirm('@L["Common_Delete"] @(_dog.Name)?')">
                            <span class="material-symbols-outlined text-base">delete</span>
                            @L["Common_Delete"]
                        </button>
                    </form>
                </AuthorizeView>
                <a href="/dogs/@_dog.Id/edit" class="flex items-center gap-xs px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container-high transition-all">
                    <span class="material-symbols-outlined text-base">edit</span>
                    @L["Common_Edit"]
                </a>
                <span class="@StatusChipClass(_dog.Status) px-md py-2 rounded-full font-label-md flex items-center gap-xs">
                    <span class="material-symbols-outlined text-base">@StatusIcon(_dog.Status)</span>
                    @DogStatusDisplay(_dog.Status, L)
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
            <div class="space-y-md">
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <div class="h-48 bg-surface-container-high rounded-lg flex items-center justify-center mb-md overflow-hidden">
                        @if (!string.IsNullOrEmpty(_dog.PhotoUrl))
                        {
                            <img src="@_dog.PhotoUrl" alt="@_dog.Name" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-primary-fixed-dim text-8xl" style="font-variation-settings:'FILL' 1">pets</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_dog.Traits))
                    {
                        <div class="flex flex-wrap gap-xs mb-md">
                            @foreach (var tag in _dog.Traits.Split(','))
                            {
                                <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-label-sm">@tag.Trim()</span>
                            }
                        </div>
                    }
                    <div class="space-y-xs text-body-sm text-on-surface-variant">
                        <p><span class="font-semibold text-on-surface">@L["DogDetail_Arrived"]</span> @_dog.ArrivalDate.ToString("MMM d, yyyy")</p>
                        @if (!string.IsNullOrEmpty(_dog.Notes))
                        {
                            <p><span class="font-semibold text-on-surface">@L["DogDetail_NotesLabel"]</span> @_dog.Notes</p>
                        }
                    </div>
                    <div class="mt-md flex gap-sm">
                        <a href="/adoptions?dogId=@_dog.Id" class="flex-1 text-center py-2 bg-secondary text-on-secondary rounded-lg font-label-md hover:brightness-110 transition-all">@L["DogDetail_StartAdoption"]</a>
                        <a href="/health?dogId=@_dog.Id" class="flex-1 text-center py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">@L["DogDetail_HealthRecord"]</a>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-md">
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">@L["DogDetail_MedicalHistory"]</h3>
                    @if (!_records.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant">@L["DogDetail_NoMedicalRecords"]</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var rec in _records)
                            {
                                <div class="py-sm">
                                    <div class="flex justify-between items-start gap-sm">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex justify-between items-start">
                                                <h4 class="font-label-md text-on-surface">@rec.Diagnosis</h4>
                                                <span class="text-body-sm text-on-surface-variant flex-shrink-0 ml-sm">@rec.VisitDate.ToString("MMM d, yyyy")</span>
                                            </div>
                                            <p class="text-body-sm text-on-surface-variant">@rec.VetName • @rec.Treatment</p>
                                            @if (rec.NextVisitDate.HasValue)
                                            {
                                                <p class="text-label-sm text-primary">@L["DogDetail_Next"] @rec.NextVisitDate.Value.ToString("MMM d, yyyy")</p>
                                            }
                                        </div>
                                        <div class="flex gap-xs flex-shrink-0">
                                            <a href="/dogs/@_dog.Id/medical/@rec.Id" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all" title="@L["Common_Edit"]">
                                                <span class="material-symbols-outlined text-sm">edit</span>
                                            </a>
                                            <AuthorizeView Roles="Manager">
                                                <form method="post" action="/api/medical/@rec.Id/delete?dogId=@_dog.Id" class="contents">
                                                    <AntiforgeryToken />
                                                    <button type="submit"
                                                            class="w-8 h-8 flex items-center justify-center rounded-lg border border-error/40 text-error hover:bg-error-container/20 transition-all"
                                                            title="@L["Common_Delete"]"
                                                            onclick="return confirm('@L["Common_Delete"]?')">
                                                        <span class="material-symbols-outlined text-sm">delete</span>
                                                    </button>
                                                </form>
                                            </AuthorizeView>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">@L["DogDetail_ActiveMedications"]</h3>
                    @if (!_medications.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant">@L["DogDetail_NoActiveMedications"]</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var med in _medications)
                            {
                                <div class="py-sm flex justify-between items-center gap-sm">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-xs">
                                            <p class="font-label-md text-on-surface">@med.Name</p>
                                            @if (!med.IsActive)
                                            {
                                                <span class="text-label-sm text-on-surface-variant bg-surface-container-high px-xs py-0.5 rounded-full">@L["Health_MedCompleted"]</span>
                                            }
                                        </div>
                                        <p class="text-body-sm text-on-surface-variant">@med.Dosage • @med.Frequency</p>
                                        @if (med.EndDate.HasValue)
                                        {
                                            <span class="text-label-sm @(med.IsActive && med.EndDate < DateTime.UtcNow.AddDays(3) ? "text-error" : "text-on-surface-variant")">
                                                @string.Format(L["DogDetail_Until"].Value, med.EndDate.Value.ToString("MMM d"))
                                            </span>
                                        }
                                    </div>
                                    <div class="flex gap-xs flex-shrink-0">
                                        <a href="/dogs/@_dog.Id/medications/@med.Id" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all" title="@L["Common_Edit"]">
                                            <span class="material-symbols-outlined text-sm">edit</span>
                                        </a>
                                        <AuthorizeView Roles="Manager">
                                            <form method="post" action="/api/medications/@med.Id/delete?dogId=@_dog.Id" class="contents">
                                                <AntiforgeryToken />
                                                <button type="submit"
                                                        class="w-8 h-8 flex items-center justify-center rounded-lg border border-error/40 text-error hover:bg-error-container/20 transition-all"
                                                        title="@L["Common_Delete"]"
                                                        onclick="return confirm('@L["Common_Delete"]?')">
                                                    <span class="material-symbols-outlined text-sm">delete</span>
                                                </button>
                                            </form>
                                        </AuthorizeView>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private DogDto? _dog;
    private List<MedicalRecordDto> _records = [];
    private List<MedicationDto> _medications = [];

    protected override async Task OnInitializedAsync()
    {
        _dog = await Api.GetDog(Id);
        if (_dog is not null)
        {
            _records = await Api.GetMedicalRecords(Id);
            _medications = await Api.GetMedications(Id);
        }
        _loading = false;
    }

}
