@page "/change-password"
@layout MainLayout
@attribute [Authorize]

<PageTitle>@L["ChangePassword_Title"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop max-w-lg">
    <h2 class="font-headline-xl text-headline-xl text-primary mb-xs">@L["ChangePassword_Title"]</h2>
    <p class="text-body-md text-on-surface-variant mb-lg">@L["ChangePassword_Subtitle"]</p>

    @if (_success)
    {
        <div class="bg-primary-fixed text-on-primary-fixed rounded-lg px-md py-sm mb-md text-body-sm flex items-center gap-sm">
            <span class="material-symbols-outlined" style="font-size:18px">check_circle</span>
            @L["ChangePassword_Success"]
        </div>
    }
    @if (_error)
    {
        <div class="bg-error-container text-on-error-container rounded-lg px-md py-sm mb-md text-body-sm flex items-center gap-sm">
            <span class="material-symbols-outlined" style="font-size:18px">error</span>
            @L["ChangePassword_Error"]
        </div>
    }

    <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
        <form method="post" action="/auth/change-password" class="space-y-md">
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["ChangePassword_CurrentPassword"]</label>
                <input name="currentPassword" type="password" required autocomplete="current-password"
                       class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["ChangePassword_NewPassword"]</label>
                <input name="newPassword" type="password" required minlength="6" autocomplete="new-password"
                       class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["ChangePassword_ConfirmNewPassword"]</label>
                <input name="confirmPassword" type="password" required minlength="6" autocomplete="new-password"
                       class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
            </div>
            <button type="submit"
                    class="w-full bg-primary text-on-primary py-3 rounded-lg font-label-md hover:brightness-110 transition-all">
                @L["ChangePassword_UpdatePassword"]
            </button>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "success")] private string? SuccessParam { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorParam { get; set; }
    private bool _success => SuccessParam == "1";
    private bool _error => ErrorParam == "1";
}
