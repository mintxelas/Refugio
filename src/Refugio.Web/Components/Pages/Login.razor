@page "/login"
@layout BlankLayout

<PageTitle>@L["Login_SignIn"] – @L["App_Name"]</PageTitle>

<div class="min-h-screen bg-background flex items-center justify-center p-md">
    <div class="w-full max-w-sm">
        <div class="text-center mb-lg">
            <div class="w-16 h-16 rounded-2xl bg-primary flex items-center justify-center mx-auto mb-md">
                <span class="material-symbols-outlined text-on-primary" style="font-size:36px;font-variation-settings:'FILL' 1">pets</span>
            </div>
            <h1 class="font-headline-xl text-headline-xl text-primary">@L["App_Name"]</h1>
            <p class="text-body-md text-on-surface-variant mt-xs">@L["Login_Subtitle"]</p>
        </div>

        @if (_hasError)
        {
            <div class="bg-error-container text-on-error-container rounded-lg px-md py-sm mb-md text-body-sm flex items-center gap-sm">
                <span class="material-symbols-outlined" style="font-size:18px">error</span>
                @L["Login_InvalidCredentials"]
            </div>
        }

        <div class="bg-surface-container-lowest rounded-2xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" action="/auth/login" class="space-y-md">
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Login_EmailAddress"]</label>
                    <input name="email" type="email" autocomplete="email" required
                           class="w-full border border-outline-variant rounded-lg px-3 py-2.5 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Login_Password"]</label>
                    <input name="password" type="password" autocomplete="current-password" required
                           class="w-full border border-outline-variant rounded-lg px-3 py-2.5 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
                </div>
                <button type="submit"
                        class="w-full bg-primary text-on-primary py-3 rounded-lg font-label-md text-label-md hover:brightness-110 transition-all mt-sm">
                    @L["Login_SignIn"]
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorParam { get; set; }
    private bool _hasError => ErrorParam == "1";
}
