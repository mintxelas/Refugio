@page "/funds"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Nav_Funds"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-primary">@L["Funds_Title"]</h2>
            <p class="text-body-md text-on-surface-variant">@L["Funds_Subtitle"]</p>
        </div>
    </div>

    <!-- Register Income collapsible -->
    <details class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
        <summary class="flex items-center justify-between px-md py-4 cursor-pointer hover:bg-surface-container transition-colors select-none list-none">
            <span class="flex items-center gap-sm font-label-md text-label-md text-primary">
                <span class="material-symbols-outlined">add_circle</span>
                @L["Funds_RegisterIncome"]
            </span>
            <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
        </summary>
        <div class="px-md pb-md border-t border-outline-variant/30 pt-md">
            <form method="post" @formname="add-donation" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-3 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_DonorName"]</label>
                        <input name="DonorName" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_AmountRequired"]</label>
                        <input name="Amount" type="number" step="0.01" min="0.01" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Category"]</label>
                        <select name="Category" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            @foreach (var cat in Enum.GetValues<DonationCategory>())
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                    <div class="col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                        <input name="Notes" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div class="flex gap-sm justify-end">
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                        @L["Funds_SaveIncome"]
                    </button>
                </div>
            </form>
        </div>
    </details>

    <!-- Register Expense collapsible -->
    <details class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
        <summary class="flex items-center justify-between px-md py-4 cursor-pointer hover:bg-surface-container transition-colors select-none list-none">
            <span class="flex items-center gap-sm font-label-md text-label-md text-secondary">
                <span class="material-symbols-outlined">remove_circle</span>
                @L["Funds_RegisterExpense"]
            </span>
            <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
        </summary>
        <div class="px-md pb-md border-t border-outline-variant/30 pt-md">
            <form method="post" @formname="add-expense" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-3 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_DescriptionRequired"]</label>
                        <input name="Description" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_AmountRequired"]</label>
                        <input name="Amount" type="number" step="0.01" min="0.01" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Category"]</label>
                        <input name="Category" placeholder="@L["Funds_CategoryPlaceholder"]" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div class="col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                        <input name="Notes" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div class="flex gap-sm justify-end">
                    <button type="submit" class="px-md py-2 bg-secondary text-on-secondary rounded-lg font-label-md hover:brightness-110 transition-all">
                        @L["Funds_SaveExpense"]
                    </button>
                </div>
            </form>
        </div>
    </details>

    <!-- Chart + Goal card -->
    <div class="grid grid-cols-12 gap-gutter">
        <div class="col-span-8 bg-surface-container-lowest rounded-xl p-md shadow-soft border border-outline-variant/30">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-headline-md text-headline-md text-on-surface">@L["Funds_IncomeVsExpenses"]</h3>
                <div class="flex gap-2 text-label-sm">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-primary inline-block"></span> @L["Funds_Income"]</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-secondary inline-block"></span> @L["Funds_Expenses"]</span>
                </div>
            </div>
            @if (_summary is not null)
            {
                var maxVal = _summary.Monthly.Max(m => Math.Max(m.Income, m.Expenses));
                maxVal = maxVal == 0 ? 1 : maxVal;
                <div class="h-64 flex items-end justify-between gap-2 px-2 pb-2 border-b border-outline-variant">
                    @foreach (var m in _summary.Monthly.Take(6))
                    {
                        <div class="flex-1 flex flex-col items-center gap-1">
                            <div class="flex items-end gap-1 w-full justify-center">
                                <div class="w-4 bg-primary rounded-t-sm" style="height:@((int)(m.Income / maxVal * 200))px"></div>
                                <div class="w-4 bg-secondary rounded-t-sm" style="height:@((int)(m.Expenses / maxVal * 200))px"></div>
                            </div>
                            <span class="text-label-sm text-on-surface-variant">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Month)</span>
                        </div>
                    }
                </div>
                <div class="grid grid-cols-2 gap-md mt-md">
                    <div class="bg-primary-fixed/50 rounded-lg p-sm">
                        <p class="text-label-sm text-on-surface-variant">@L["Funds_TotalIncome"]</p>
                        <p class="font-headline-md text-headline-md text-primary">$@_summary.TotalIncome.ToString("N2")</p>
                    </div>
                    <div class="bg-secondary-fixed/50 rounded-lg p-sm">
                        <p class="text-label-sm text-on-surface-variant">@L["Funds_TotalExpenses"]</p>
                        <p class="font-headline-md text-headline-md text-secondary">$@_summary.TotalExpenses.ToString("N2")</p>
                    </div>
                </div>
            }
        </div>
        <div class="col-span-4 bg-primary text-on-primary rounded-xl p-md flex flex-col justify-between shadow-soft relative overflow-hidden">
            <div class="z-10">
                <span class="inline-block bg-primary-container text-on-primary-container px-2 py-1 rounded text-label-sm font-bold uppercase tracking-wider mb-2">@L["Funds_OngoingGoal"]</span>
                <h3 class="font-headline-md text-headline-md leading-tight mb-sm">@L["Funds_GoalTitle"]</h3>
                <p class="text-body-sm opacity-90">@L["Funds_GoalDesc"]</p>
            </div>
            @{
                var goalPct = _summary is null ? 0 : Math.Min(100, (int)(_summary.TotalIncome / 45000m * 100));
            }
            <div class="z-10 mt-md">
                <div class="flex justify-between items-end mb-2">
                    <span class="font-headline-md text-headline-md">$@(_summary?.TotalIncome.ToString("N0"))</span>
                    <span class="text-label-md opacity-70">@L["Funds_GoalAmount"]</span>
                </div>
                <div class="w-full h-4 bg-white/20 rounded-full overflow-hidden">
                    <div class="h-full bg-on-primary-container rounded-full" style="width:@goalPct%"></div>
                </div>
                <div class="flex justify-between mt-2 text-label-sm">
                    <span>@string.Format(L["Funds_PctReached"].Value, goalPct)</span>
                </div>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -top-4 text-9xl opacity-10 rotate-12">airport_shuttle</span>
        </div>
    </div>

    <!-- Tabs -->
    <div class="flex items-center gap-sm justify-between">
        <div class="flex gap-sm">
            <a href="/funds"
               class="px-md py-2 rounded-full font-label-md text-label-md border transition-all @(Tab != "expenses" ? "bg-primary text-on-primary border-primary" : "border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary")">
                @L["Funds_Donations"]
            </a>
            <a href="/funds?tab=expenses"
               class="px-md py-2 rounded-full font-label-md text-label-md border transition-all @(Tab == "expenses" ? "bg-secondary text-on-secondary border-secondary" : "border-outline-variant text-on-surface-variant hover:border-secondary hover:text-secondary")">
                @L["Funds_Expenses"]
            </a>
        </div>
        <a href="@(Tab == "expenses" ? "/api/export/expenses" : "/api/export/donations")"
           class="flex items-center gap-xs px-md py-2 rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined text-base">download</span>
            @L["Common_ExportCsv"]
        </a>
    </div>

    @if (Tab != "expenses")
    {
        <!-- Donations table -->
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="flex px-md py-3 bg-surface-container text-on-surface-variant font-label-md text-label-sm uppercase tracking-wider">
                <div class="flex-[2]">@L["Funds_DonorCol"]</div>
                <div class="flex-1">@L["Common_Category"]</div>
                <div class="flex-1">@L["Common_Date"]</div>
                <div class="flex-1 text-right">@L["Common_Amount"]</div>
                <div class="w-16 text-right">@L["Common_Edit"]</div>
            </div>
            <div class="divide-y divide-outline-variant/20">
                @foreach (var (d, i) in _donations.Select((d, i) => (d, i)))
                {
                    <div class="relative flex items-center px-md py-3 @(i % 2 == 1 ? "bg-tertiary-fixed/5" : "") hover:bg-surface-container transition-colors cursor-pointer">
                        <a href="/funds/donations/@d.Id" class="absolute inset-0" aria-label="Edit @d.DonorName"></a>
                        <div class="flex-[2] flex items-center gap-sm pointer-events-none">
                            <div class="w-8 h-8 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed font-bold text-xs">
                                @string.Concat(d.DonorName.Split(' ').Take(2).Select(w => w.FirstOrDefault()))
                            </div>
                            <div>
                                <p class="font-label-md text-on-surface">@d.DonorName</p>
                                @if (!string.IsNullOrEmpty(d.Notes))
                                {
                                    <p class="text-body-sm text-on-surface-variant">@d.Notes</p>
                                }
                            </div>
                        </div>
                        <div class="flex-1 pointer-events-none">
                            <span class="@CategoryBadge(d.Category) px-sm py-0.5 rounded-full text-label-sm font-bold">@d.Category</span>
                        </div>
                        <div class="flex-1 text-body-sm text-on-surface-variant pointer-events-none">@d.Date.ToString("MMM d, yyyy")</div>
                        <div class="flex-1 text-right font-bold text-primary pointer-events-none">$@d.Amount.ToString("F2")</div>
                        <div class="w-16 flex justify-end relative z-10">
                            <a href="/funds/donations/@d.Id" class="text-on-surface-variant hover:text-primary transition-colors">
                                <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
            @if (!_donations.Any())
            {
                <div class="py-lg text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-5xl block mb-sm">payments</span>
                    <p class="text-body-lg">@L["Funds_NoDonations"]</p>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Expenses table -->
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
            <div class="flex px-md py-3 bg-surface-container text-on-surface-variant font-label-md text-label-sm uppercase tracking-wider">
                <div class="flex-[2]">@L["Common_Description"]</div>
                <div class="flex-1">@L["Common_Category"]</div>
                <div class="flex-1">@L["Common_Date"]</div>
                <div class="flex-1 text-right">@L["Common_Amount"]</div>
                <div class="w-16 text-right">@L["Common_Edit"]</div>
            </div>
            <div class="divide-y divide-outline-variant/20">
                @foreach (var (e, i) in _expenses.Select((e, i) => (e, i)))
                {
                    <div class="relative flex items-center px-md py-3 @(i % 2 == 1 ? "bg-tertiary-fixed/5" : "") hover:bg-surface-container transition-colors cursor-pointer">
                        <a href="/funds/expenses/@e.Id" class="absolute inset-0" aria-label="Edit @e.Description"></a>
                        <div class="flex-[2] pointer-events-none">
                            <p class="font-label-md text-on-surface">@e.Description</p>
                            @if (!string.IsNullOrEmpty(e.Notes))
                            {
                                <p class="text-body-sm text-on-surface-variant">@e.Notes</p>
                            }
                        </div>
                        <div class="flex-1 text-body-sm text-on-surface-variant pointer-events-none">@e.Category</div>
                        <div class="flex-1 text-body-sm text-on-surface-variant pointer-events-none">@e.Date.ToString("MMM d, yyyy")</div>
                        <div class="flex-1 text-right font-bold text-secondary pointer-events-none">$@e.Amount.ToString("F2")</div>
                        <div class="w-16 flex justify-end relative z-10">
                            <a href="/funds/expenses/@e.Id" class="text-on-surface-variant hover:text-secondary transition-colors">
                                <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
            @if (!_expenses.Any())
            {
                <div class="py-lg text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-5xl block mb-sm">receipt_long</span>
                    <p class="text-body-lg">@L["Funds_NoExpenses"]</p>
                </div>
            }
        </div>
    }

    @if (_totalPages > 1)
    {
        <div class="flex items-center justify-between pt-sm">
            <p class="text-body-sm text-on-surface-variant">
                @string.Format(L["Common_Showing"].Value, FirstItem, LastItem, _totalCount)
            </p>
            <div class="flex items-center gap-sm">
                @if (CurrentPage > 1)
                {
                    <a href="@PageUrl(CurrentPage - 1)"
                       class="px-md py-2 rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container transition-colors flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">chevron_left</span>
                        @L["Common_PrevPage"]
                    </a>
                }
                <div class="flex gap-xs">
                    @foreach (var p in PageNumbers())
                    {
                        @if (p == 0)
                        {
                            <span class="px-sm py-2 text-on-surface-variant text-label-sm">…</span>
                        }
                        else
                        {
                            <a href="@PageUrl(p)"
                               class="w-9 h-9 flex items-center justify-center rounded-lg text-label-md font-label-md transition-colors @(p == CurrentPage ? "bg-primary text-on-primary" : "border border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                                @p
                            </a>
                        }
                    }
                </div>
                @if (CurrentPage < _totalPages)
                {
                    <a href="@PageUrl(CurrentPage + 1)"
                       class="px-md py-2 rounded-lg border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container transition-colors flex items-center gap-xs">
                        @L["Common_NextPage"]
                        <span class="material-symbols-outlined text-base">chevron_right</span>
                    </a>
                }
            </div>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "tab")]  private string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private int PageParam { get; set; } = 1;

    private List<Donation> _donations = [];
    private List<Expense>  _expenses  = [];
    private FinanceSummary? _summary;
    private int _totalCount;
    private int _totalPages;
    private const int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var handler = form["_handler"].ToString();

            if (handler == "add-donation")
            {
                var name = form["DonorName"].ToString();
                if (!string.IsNullOrWhiteSpace(name) && decimal.TryParse(form["Amount"].ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amt) && amt > 0)
                {
                    var cat = Enum.TryParse<DonationCategory>(form["Category"].ToString(), out var c) ? c : DonationCategory.OneTime;
                    var notes = form["Notes"].ToString() is { Length: > 0 } n ? n : null;
                    await Api.CreateDonation(new CreateDonation(name, amt, cat, notes));
                    Nav.NavigateTo("/funds");
                    return;
                }
            }
            else if (handler == "add-expense")
            {
                var desc = form["Description"].ToString();
                if (!string.IsNullOrWhiteSpace(desc) && decimal.TryParse(form["Amount"].ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amt) && amt > 0)
                {
                    var category = form["Category"].ToString();
                    var notes = form["Notes"].ToString() is { Length: > 0 } n ? n : null;
                    await Api.CreateExpense(new CreateExpense(desc, amt, category, notes));
                    Nav.NavigateTo("/funds?tab=expenses");
                    return;
                }
            }
        }

        var page = PageParam < 1 ? 1 : PageParam;
        _summary = await Api.GetFinanceSummary(DateTime.UtcNow.Year);

        if (Tab == "expenses")
        {
            var ep = await Api.GetExpensesPaged(page, PageSize);
            _expenses  = ep.Items;
            _totalCount = ep.TotalCount;
        }
        else
        {
            var dp = await Api.GetDonationsPaged(page, PageSize);
            _donations  = dp.Items;
            _totalCount = dp.TotalCount;
        }
        _totalPages = (int)Math.Ceiling((double)_totalCount / PageSize);
    }

    private int CurrentPage => PageParam < 1 ? 1 : PageParam;
    private int FirstItem => _totalCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int LastItem  => Math.Min(CurrentPage * PageSize, _totalCount);

    private string PageUrl(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(Tab)) parts.Add($"tab={Uri.EscapeDataString(Tab)}");
        if (page > 1) parts.Add($"page={page}");
        return "/funds" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }

    private IEnumerable<int> PageNumbers()
    {
        var pages = new List<int>();
        for (var p = 1; p <= _totalPages; p++)
        {
            if (p == 1 || p == _totalPages || Math.Abs(p - CurrentPage) <= 2)
                pages.Add(p);
        }
        var result = new List<int>();
        int? prev = null;
        foreach (var p in pages)
        {
            if (prev.HasValue && p - prev.Value > 1) result.Add(0);
            result.Add(p);
            prev = p;
        }
        return result;
    }

    private string CategoryBadge(DonationCategory cat) => cat switch
    {
        DonationCategory.Monthly   => "bg-primary-fixed text-on-primary-fixed",
        DonationCategory.Corporate => "bg-secondary-container text-on-secondary-container",
        _                          => "bg-surface-container-high text-on-surface-variant"
    };
}
