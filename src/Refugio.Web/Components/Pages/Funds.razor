@page "/funds"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api

<PageTitle>Funds & Finances – Haven Sanctuary</PageTitle>

<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-primary">Funds & Finances</h2>
            <p class="text-body-md text-on-surface-variant">Real-time overview of the sanctuary's financial health.</p>
        </div>
        <div class="flex gap-sm">
            <button @onclick="() => _showExpense = !_showExpense"
                    class="px-md py-2.5 rounded-lg border-2 border-secondary text-secondary font-label-md flex items-center gap-2 hover:bg-secondary/5 transition-all">
                <span class="material-symbols-outlined">remove_circle</span> Register Expense
            </button>
            <button @onclick="() => _showDonation = !_showDonation"
                    class="px-md py-2.5 rounded-lg bg-primary text-on-primary font-label-md flex items-center gap-2 hover:brightness-110 transition-all">
                <span class="material-symbols-outlined">add_circle</span> Register Income
            </button>
        </div>
    </div>

    @if (_showDonation)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md space-y-md">
            <h3 class="font-headline-md text-headline-md text-on-surface">Register Donation</h3>
            <div class="grid grid-cols-3 gap-md">
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Donor Name</label>
                    <input @bind="_donorName" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Amount ($)</label>
                    <input @bind="_donorAmount" type="number" step="0.01" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Category</label>
                    <select @bind="_donorCategory" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary">
                        @foreach (var cat in Enum.GetValues<DonationCategory>())
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
            </div>
            <div class="flex gap-sm justify-end">
                <button @onclick="() => _showDonation = false" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md">Cancel</button>
                <button @onclick="SaveDonation" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110">Save</button>
            </div>
        </div>
    }

    @if (_showExpense)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md space-y-md">
            <h3 class="font-headline-md text-headline-md text-on-surface">Register Expense</h3>
            <div class="grid grid-cols-3 gap-md">
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Description</label>
                    <input @bind="_expenseDesc" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Amount ($)</label>
                    <input @bind="_expenseAmount" type="number" step="0.01" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Category</label>
                    <input @bind="_expenseCategory" placeholder="Medical, Food, Facilities..." class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                </div>
            </div>
            <div class="flex gap-sm justify-end">
                <button @onclick="() => _showExpense = false" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md">Cancel</button>
                <button @onclick="SaveExpense" class="px-md py-2 bg-secondary text-on-secondary rounded-lg font-label-md hover:brightness-110">Save</button>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="flex justify-center py-16">
            <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
        </div>
    }
    else
    {
        <div class="grid grid-cols-12 gap-gutter">
            <!-- Chart -->
            <div class="col-span-8 bg-surface-container-lowest rounded-xl p-md shadow-soft border border-outline-variant/30">
                <div class="flex justify-between items-center mb-lg">
                    <h3 class="font-headline-md text-headline-md text-on-surface">Income vs. Expenses</h3>
                    <div class="flex gap-2 text-label-sm">
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-primary inline-block"></span> Income</span>
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-secondary inline-block"></span> Expenses</span>
                    </div>
                </div>
                @if (_summary is not null)
                {
                    var maxVal = _summary.Monthly.Max(m => Math.Max(m.Income, m.Expenses));
                    maxVal = maxVal == 0 ? 1 : maxVal;
                    <div class="h-64 flex items-end justify-between gap-2 px-2 pb-2 border-b border-outline-variant">
                        @foreach (var m in _summary.Monthly.Take(6))
                        {
                            <div class="flex-1 flex flex-col items-center gap-1">
                                <div class="flex items-end gap-1 w-full justify-center">
                                    <div class="w-4 bg-primary rounded-t-sm" style="height:@((int)(m.Income / maxVal * 200))px"></div>
                                    <div class="w-4 bg-secondary rounded-t-sm" style="height:@((int)(m.Expenses / maxVal * 200))px"></div>
                                </div>
                                <span class="text-label-sm text-on-surface-variant">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Month)</span>
                            </div>
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-md mt-md">
                        <div class="bg-primary-fixed/50 rounded-lg p-sm">
                            <p class="text-label-sm text-on-surface-variant">Total Income</p>
                            <p class="font-headline-md text-headline-md text-primary">$@_summary.TotalIncome.ToString("N2")</p>
                        </div>
                        <div class="bg-secondary-fixed/50 rounded-lg p-sm">
                            <p class="text-label-sm text-on-surface-variant">Total Expenses</p>
                            <p class="font-headline-md text-headline-md text-secondary">$@_summary.TotalExpenses.ToString("N2")</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Campaign card -->
            <div class="col-span-4 bg-primary text-on-primary rounded-xl p-md flex flex-col justify-between shadow-soft relative overflow-hidden">
                <div class="z-10">
                    <span class="inline-block bg-primary-container text-on-primary-container px-2 py-1 rounded text-label-sm font-bold uppercase tracking-wider mb-2">Ongoing Goal</span>
                    <h3 class="font-headline-md text-headline-md leading-tight mb-sm">Rescue Van 2024</h3>
                    <p class="text-body-sm opacity-90">Replacing our oldest ambulance with a specialized pet transport unit.</p>
                </div>
                @{
                    var goalPct = _summary is null ? 0 : Math.Min(100, (int)(_summary.TotalIncome / 45000m * 100));
                }
                <div class="z-10 mt-md">
                    <div class="flex justify-between items-end mb-2">
                        <span class="font-headline-md text-headline-md">$@(_summary?.TotalIncome.ToString("N0"))</span>
                        <span class="text-label-md opacity-70">Goal: $45,000</span>
                    </div>
                    <div class="w-full h-4 bg-white/20 rounded-full overflow-hidden">
                        <div class="h-full bg-on-primary-container rounded-full" style="width:@goalPct%"></div>
                    </div>
                    <div class="flex justify-between mt-2 text-label-sm">
                        <span>@goalPct% Reached</span>
                    </div>
                </div>
                <span class="material-symbols-outlined absolute -right-4 -top-4 text-9xl opacity-10 rotate-12">airport_shuttle</span>
            </div>
        </div>

        <!-- Recent Donations Table -->
        <div class="bg-surface-container-lowest rounded-xl p-md shadow-soft border border-outline-variant/30">
            <div class="flex justify-between items-center mb-md">
                <h3 class="font-headline-md text-headline-md text-on-surface">Recent Donations</h3>
            </div>
            <div class="flex flex-col">
                <div class="flex px-4 py-3 bg-surface-container text-on-surface-variant font-label-md text-label-sm uppercase tracking-wider rounded-lg mb-xs">
                    <div class="flex-[2]">Donor</div>
                    <div class="flex-1">Category</div>
                    <div class="flex-1">Date</div>
                    <div class="flex-1 text-right">Amount</div>
                </div>
                @foreach (var (d, i) in _donations.Take(10).Select((d, i) => (d, i)))
                {
                    <div class="flex items-center px-4 py-3 @(i % 2 == 1 ? "bg-tertiary-fixed/10" : "") hover:bg-surface-container-high cursor-pointer rounded transition-colors">
                        <div class="flex-[2] flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed font-bold text-xs">
                                @string.Concat(d.DonorName.Split(' ').Take(2).Select(w => w.FirstOrDefault()))
                            </div>
                            <span class="font-label-md text-on-surface">@d.DonorName</span>
                        </div>
                        <div class="flex-1">
                            <span class="@CategoryBadge(d.Category) px-3 py-1 rounded-full text-label-sm font-bold flex items-center w-fit gap-1">
                                @d.Category
                            </span>
                        </div>
                        <div class="flex-1 text-on-surface-variant text-body-sm">@d.Date.ToString("MMM d, yyyy")</div>
                        <div class="flex-1 text-right font-bold text-primary">$@d.Amount.ToString("F2")</div>
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private bool _showDonation, _showExpense;
    private List<Donation> _donations = [];
    private List<Expense> _expenses = [];
    private FinanceSummary? _summary;

    private string _donorName = "", _expenseDesc = "", _expenseCategory = "";
    private decimal _donorAmount, _expenseAmount;
    private DonationCategory _donorCategory = DonationCategory.OneTime;

    protected override async Task OnInitializedAsync()
    {
        _donations = await Api.GetDonations();
        _expenses = await Api.GetExpenses();
        _summary = await Api.GetFinanceSummary(DateTime.UtcNow.Year);
        _loading = false;
    }

    private async Task SaveDonation()
    {
        if (string.IsNullOrWhiteSpace(_donorName) || _donorAmount <= 0) return;
        await Api.CreateDonation(new CreateDonation(_donorName, _donorAmount, _donorCategory, null));
        _donations = await Api.GetDonations();
        _summary = await Api.GetFinanceSummary(DateTime.UtcNow.Year);
        _donorName = ""; _donorAmount = 0; _showDonation = false;
    }

    private async Task SaveExpense()
    {
        if (string.IsNullOrWhiteSpace(_expenseDesc) || _expenseAmount <= 0) return;
        await Api.CreateExpense(new CreateExpense(_expenseDesc, _expenseAmount, _expenseCategory, null));
        _expenses = await Api.GetExpenses();
        _summary = await Api.GetFinanceSummary(DateTime.UtcNow.Year);
        _expenseDesc = ""; _expenseAmount = 0; _showExpense = false;
    }

    private string CategoryBadge(DonationCategory cat) => cat switch
    {
        DonationCategory.Monthly => "bg-primary-fixed text-on-primary-fixed",
        DonationCategory.Corporate => "bg-secondary-container text-on-secondary-container",
        _ => "bg-surface-container-high text-on-surface-variant"
    };
}
