@page "/reports"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api

<PageTitle>@L["Reports_Title"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop max-w-screen-xl mx-auto space-y-lg">
    <div>
        <h2 class="font-headline-xl text-headline-xl text-primary">@L["Reports_Title"]</h2>
        <p class="text-body-md text-on-surface-variant">@L["Reports_Subtitle"]</p>
    </div>

    <!-- Year selector -->
    <div class="flex items-center gap-sm">
        <span class="font-label-md text-on-surface-variant">@L["Reports_YearLabel"]:</span>
        @foreach (var y in _years)
        {
            <a href="/reports?year=@y"
               class="px-sm py-1 rounded border text-label-sm font-label-sm transition-all @(y == _year ? "bg-primary text-on-primary border-primary" : "border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary")">
                @y
            </a>
        }
    </div>

    <!-- Adoption Conversion -->
    <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-xs">@L["Reports_AdoptionConversion"]</h3>
        <p class="text-body-sm text-on-surface-variant mb-md">@L["Reports_AdoptionConversionSubtitle"]</p>
        @if (_conversion is not null)
        {
            var hasData = _conversion.TotalApplied > 0 || _conversion.TotalFinalized > 0;
            if (!hasData)
            {
                <p class="text-body-sm text-on-surface-variant py-lg text-center">@L["Reports_NoData"]</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-body-sm">
                        <thead>
                            <tr class="border-b border-outline-variant/30 text-on-surface-variant font-label-sm text-left">
                                <th class="py-2 pr-md">@L["Reports_Month"]</th>
                                <th class="py-2 pr-md text-right">@L["Reports_Applied"]</th>
                                <th class="py-2 pr-md text-right">@L["Reports_Finalized"]</th>
                                <th class="py-2 text-right">@L["Reports_ConversionRate"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">
                            @foreach (var m in _conversion.Monthly.Where(m => m.Applied > 0 || m.Finalized > 0))
                            {
                                var rate = m.Applied > 0 ? (m.Finalized * 100.0 / m.Applied) : 0.0;
                                <tr class="hover:bg-surface-container transition-colors">
                                    <td class="py-2 pr-md font-label-md">@_monthName(m.Month)</td>
                                    <td class="py-2 pr-md text-right">@m.Applied</td>
                                    <td class="py-2 pr-md text-right text-primary font-bold">@m.Finalized</td>
                                    <td class="py-2 text-right @(rate >= 50 ? "text-primary" : rate >= 25 ? "text-secondary" : "text-on-surface-variant")">@rate.ToString("F0")%</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-t border-outline-variant font-bold text-on-surface">
                                <td class="py-2 pr-md">@L["Reports_Total"]</td>
                                <td class="py-2 pr-md text-right">@_conversion.TotalApplied</td>
                                <td class="py-2 pr-md text-right text-primary">@_conversion.TotalFinalized</td>
                                <td class="py-2 text-right">
                                    @(_conversion.TotalApplied > 0 ? (_conversion.TotalFinalized * 100.0 / _conversion.TotalApplied).ToString("F0") + "%" : "—")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
    </div>

    <!-- Shelter Stay by Breed -->
    <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-xs">@L["Reports_ShelterStay"]</h3>
        <p class="text-body-sm text-on-surface-variant mb-md">@L["Reports_ShelterStaySubtitle"]</p>
        @if (_stayStats is not null)
        {
            if (!_stayStats.ByBreed.Any())
            {
                <p class="text-body-sm text-on-surface-variant py-lg text-center">@L["Reports_NoData"]</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-body-sm">
                        <thead>
                            <tr class="border-b border-outline-variant/30 text-on-surface-variant font-label-sm text-left">
                                <th class="py-2 pr-md">@L["Reports_Breed"]</th>
                                <th class="py-2 pr-md text-right">@L["Reports_AvgDays"]</th>
                                <th class="py-2 text-right">@L["Reports_Adoptions"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">
                            @foreach (var b in _stayStats.ByBreed)
                            {
                                <tr class="hover:bg-surface-container transition-colors">
                                    <td class="py-2 pr-md font-label-md">@b.Breed</td>
                                    <td class="py-2 pr-md text-right">@b.AvgDays.ToString("F1")</td>
                                    <td class="py-2 text-right text-primary font-bold">@b.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "year")] private int Year { get; set; }

    private AdoptionConversionStats? _conversion;
    private ShelterStayStats? _stayStats;
    private int _year;
    private static readonly int[] _years = [.. Enumerable.Range(DateTime.UtcNow.Year - 3, 4).Reverse()];

    protected override async Task OnInitializedAsync()
    {
        _year = Year > 0 ? Year : DateTime.UtcNow.Year;
        var t1 = Api.GetAdoptionConversionStats(_year);
        var t2 = Api.GetShelterStayStats();
        await Task.WhenAll(t1, t2);
        _conversion = t1.Result;
        _stayStats = t2.Result;
    }

    private static string _monthName(int month) =>
        System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetAbbreviatedMonthName(month);
}
