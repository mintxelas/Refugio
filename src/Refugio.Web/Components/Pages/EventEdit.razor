@page "/calendar/events/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Edit Event – Haven Sanctuary</PageTitle>

@if (_event is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/calendar" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-primary">Edit Event</h2>
                <p class="text-body-md text-on-surface-variant">@_event.Title</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-event" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Title *</label>
                        <input name="Title" required value="@_event.Title"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Type</label>
                        <select name="EventType" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            @foreach (var t in new[] { "Walk", "Medical", "Adoption", "Training", "General" })
                            {
                                <option value="@t" selected="@(_event.EventType == t ? "selected" : null)">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Start *</label>
                        <input name="Start" type="datetime-local" required value="@_event.StartDateTime.ToString("yyyy-MM-ddTHH:mm")"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">End *</label>
                        <input name="End" type="datetime-local" required value="@_event.EndDateTime.ToString("yyyy-MM-ddTHH:mm")"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Location</label>
                        <input name="Location" value="@_event.Location"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Volunteers needed</label>
                        <input name="AssignedVolunteers" type="number" min="1" value="@_event.AssignedVolunteers"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">Description</label>
                    <textarea name="Description" rows="2" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none resize-none">@_event.Description</textarea>
                </div>
                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <a href="/api/events/@Id/delete"
                       class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                       onclick="return confirm('Delete this event?')">
                        Delete Event
                    </a>
                    <div class="flex gap-sm">
                        <a href="/calendar" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            Cancel
                        </a>
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private ShelterEvent? _event;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var title = form["Title"].ToString();
            if (!string.IsNullOrWhiteSpace(title)
                && DateTime.TryParse(form["Start"].ToString(), out var evStart)
                && DateTime.TryParse(form["End"].ToString(), out var evEnd))
            {
                var eventType = form["EventType"].ToString() is { Length: > 0 } t ? t : "General";
                int? volunteers = int.TryParse(form["AssignedVolunteers"].ToString(), out var v) && v > 0 ? v : null;
                await Api.UpdateEvent(new UpdateEvent(
                    Id, title, evStart, evEnd,
                    form["Location"].ToString() is { Length: > 0 } loc ? loc : null,
                    form["Description"].ToString() is { Length: > 0 } desc ? desc : null,
                    eventType, volunteers));
                Nav.NavigateTo("/calendar");
                return;
            }
        }

        _event = await Api.GetEvent(Id);
        if (_event is null) Nav.NavigateTo("/calendar");
    }
}
