@page "/dogs/{DogId:int}/medical/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Health_EditRecord"] – @L["App_Name"]</PageTitle>

@if (_record is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/dogs/@DogId" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-primary">@L["Health_EditRecord"]</h2>
                <p class="text-body-md text-on-surface-variant">@_record.Diagnosis</p>
            </div>
        </div>

        @if (_errors.Count > 0)
        {
            <div class="mb-md bg-error-container text-on-error-container rounded-xl p-md space-y-xs">
                @foreach (var e in _errors)
                {
                    <p class="text-body-sm flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">error</span> @e
                    </p>
                }
            </div>
        }

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-medical-record" @onsubmit="Save" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_VetName"]</label>
                        <input name="VetName" required value="@_record.VetName"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_VisitDate"]</label>
                        <input name="VisitDate" type="date" required value="@_record.VisitDate.ToString("yyyy-MM-dd")"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_Diagnosis"]</label>
                        <input name="Diagnosis" required value="@_record.Diagnosis"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_NextVisit"]</label>
                        <input name="NextVisitDate" type="date" value="@(_record.NextVisitDate?.ToString("yyyy-MM-dd") ?? "")"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div class="col-span-2">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_Treatment"]</label>
                        <input name="Treatment" required value="@_record.Treatment"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                    <textarea name="Notes" rows="2" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none resize-none">@_record.Notes</textarea>
                </div>
                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <AuthorizeView Roles="Manager">
                        <form method="post" action="/api/medical/@Id/delete?dogId=@DogId" class="inline">
                            <AntiforgeryToken />
                            <button type="submit"
                                    class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                                    onclick="return confirm('@L["Common_Delete"]?')">
                                @L["Common_Delete"]
                            </button>
                        </form>
                    </AuthorizeView>
                    <div class="flex gap-sm">
                        <a href="/dogs/@DogId" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            @L["Common_Cancel"]
                        </a>
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Common_SaveChanges"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private const string FVetName = "VetName";
    private const string FDiagnosis = "Diagnosis";
    private const string FTreatment = "Treatment";
    private const string FVisitDate = "VisitDate";
    private const string FNextVisitDate = "NextVisitDate";
    private const string FNotes = "Notes";

    [Parameter] public int DogId { get; set; }
    [Parameter] public int Id { get; set; }

    private MedicalRecord? _record;
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        _record = await Api.GetMedicalRecord(Id);
        if (_record is null) Nav.NavigateTo($"/dogs/{DogId}");
    }

    private async Task Save()
    {
        if (_record is null) return;
        var form = await HttpContextAccessor.HttpContext!.Request.ReadFormAsync();
        var vetName = GetString(form, FVetName);
        var diagnosis = GetString(form, FDiagnosis);
        var treatment = GetString(form, FTreatment);
        var visitDate = GetDateTime(form, FVisitDate);

        RequireNotEmpty(_errors, vetName, L["Validation_VetNameRequired"].Value);
        RequireNotEmpty(_errors, diagnosis, L["Validation_DiagnosisRequired"].Value);
        RequireNotEmpty(_errors, treatment, L["Validation_TreatmentRequired"].Value);
        RequireDate(_errors, visitDate, L["Validation_VisitDateRequired"].Value);
        if (_errors.Count > 0) return;

        await Api.UpdateMedicalRecord(new UpdateMedicalRecord(
            Id, vetName!, diagnosis!, treatment!,
            GetStringOrNull(form, FNotes),
            visitDate!.Value,
            GetDateTime(form, FNextVisitDate)));
        Nav.NavigateTo($"/dogs/{DogId}");
    }
}
