@page "/funds/goals/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Funds_EditGoal"] – @L["App_Name"]</PageTitle>

@if (_goal is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/funds?tab=goals" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-primary">@L["Funds_EditGoal"]</h2>
                <p class="text-body-md text-on-surface-variant">@_goal.Title</p>
            </div>
        </div>

        @if (_errors.Count > 0)
        {
            <div class="mb-md bg-error-container text-on-error-container rounded-xl p-md space-y-xs">
                @foreach (var e in _errors)
                {
                    <p class="text-body-sm flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">error</span> @e
                    </p>
                }
            </div>
        }

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-goal" @onsubmit="Save" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div class="col-span-2">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Goals_TitleRequired"]</label>
                        <input name="Title" required value="@_goal.Title"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Goals_TargetRequired"]</label>
                        <input name="TargetAmount" type="number" step="0.01" min="0.01" required value="@_goal.TargetAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Goals_CurrentAmount"]</label>
                        <input name="CurrentAmount" type="number" step="0.01" min="0" value="@_goal.CurrentAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Goals_Deadline"]</label>
                        <input name="Deadline" type="date" value="@_goal.Deadline?.ToString("yyyy-MM-dd")"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Goals_Description"]</label>
                        <input name="Description" value="@_goal.Description"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <AuthorizeView Roles="Manager">
                        <button type="submit" formaction="/api/goals/@Id/delete"
                                class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                                onclick="return confirm('@L["Common_Delete"] @_goal.Title?')">
                            @L["Common_Delete"]
                        </button>
                    </AuthorizeView>
                    <div class="flex gap-sm">
                        <a href="/funds?tab=goals" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            @L["Common_Cancel"]
                        </a>
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Common_SaveChanges"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private const string FTitle = "Title";
    private const string FTargetAmount = "TargetAmount";
    private const string FCurrentAmount = "CurrentAmount";
    private const string FDeadline = "Deadline";
    private const string FDescription = "Description";

    [Parameter] public int Id { get; set; }

    private GoalDto? _goal;
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        _goal = await Api.GetGoal(Id);
        if (_goal is null) Nav.NavigateTo("/funds?tab=goals");
    }

    private async Task Save()
    {
        if (_goal is null) return;
        var form = await HttpContextAccessor.HttpContext!.Request.ReadFormAsync();
        var title = GetString(form, FTitle);
        var target = GetDecimal(form, FTargetAmount);
        var current = GetDecimal(form, FCurrentAmount);

        RequireNotEmpty(_errors, title, L["Validation_GoalTitleRequired"].Value);
        RequirePositive(_errors, target, L["Validation_TargetPositive"].Value);
        RequireNonNegative(_errors, current, L["Validation_CurrentNonNegative"].Value);
        if (_errors.Count > 0) return;

        await Api.UpdateGoal(new UpdateGoalRequest(
            Id, title, GetStringOrNull(form, FDescription),
            target, current, GetDateTime(form, FDeadline)));
        Nav.NavigateTo("/funds?tab=goals");
    }
}
