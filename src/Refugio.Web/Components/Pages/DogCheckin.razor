@page "/dogs/new"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["DogDetail_CheckInTitle"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop max-w-2xl mx-auto space-y-lg">
    <div>
        <a href="/dogs" class="text-primary flex items-center gap-xs hover:underline font-label-md mb-md inline-flex">
            <span class="material-symbols-outlined text-base">arrow_back</span> @L["Common_BackToDogs"]
        </a>
        <h2 class="font-headline-xl text-headline-xl text-primary">@L["DogDetail_CheckInTitle"]</h2>
    </div>

    @if (_errors.Count > 0)
    {
        <div class="bg-error-container text-on-error-container rounded-xl p-md space-y-xs">
            @foreach (var e in _errors)
            {
                <p class="text-body-sm flex items-center gap-xs">
                    <span class="material-symbols-outlined text-base">error</span> @e
                </p>
            }
        </div>
    }

    <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
        <form method="post" @formname="checkin-dog" class="space-y-md">
            <AntiforgeryToken />
            <div class="grid grid-cols-2 gap-md">
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_NameRequired"]</label>
                    <input name="Name" required value="@_name"
                           class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_BreedRequired"]</label>
                    <input name="Breed" required value="@_breed"
                           class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_AgeMonths"]</label>
                    <input name="AgeMonths" type="number" min="1" required value="@(_ageMonths > 0 ? _ageMonths : 12)"
                           class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_GenderRequired"]</label>
                    <select name="Gender" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary bg-white">
                        <option value="Male">@L["DogDetail_Male"]</option>
                        <option value="Female">@L["DogDetail_Female"]</option>
                    </select>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_WeightKg"]</label>
                    <input name="WeightKg" type="number" step="0.1" min="0" value="@_weightKg.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                           class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_Traits"]</label>
                    <input name="Traits" value="@_traits" placeholder="@L["DogDetail_TraitsPlaceholder"]"
                           class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                </div>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                <textarea name="Notes" rows="3" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:border-primary resize-none">@_notes</textarea>
            </div>
            <div class="flex gap-sm justify-end pt-sm border-t border-outline-variant/20">
                <a href="/dogs" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                    @L["Common_Cancel"]
                </a>
                <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                    @L["Common_CheckInAnimal"]
                </button>
            </div>
        </form>
    </div>
</section>

@code {
    private const string FName = "Name";
    private const string FBreed = "Breed";
    private const string FAgeMonths = "AgeMonths";
    private const string FWeightKg = "WeightKg";
    private const string FGender = "Gender";
    private const string FTraits = "Traits";
    private const string FNotes = "Notes";

    private List<string> _errors = [];
    private string _name = "";
    private string _breed = "";
    private int _ageMonths;
    private decimal _weightKg;
    private string? _traits;
    private string? _notes;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method != "POST") return;

        var form = await ctx.Request.ReadFormAsync();
        _name = GetString(form, FName);
        _breed = GetString(form, FBreed);
        _ageMonths = GetInt(form, FAgeMonths);
        _weightKg = GetDecimal(form, FWeightKg);
        _traits = GetStringOrNull(form, FTraits);
        _notes = GetStringOrNull(form, FNotes);

        RequireNotEmpty(_errors, _name, L["Validation_NameRequired"].Value);
        RequireNotEmpty(_errors, _breed, L["Validation_BreedRequired"].Value);
        RequirePositive(_errors, _ageMonths, L["Validation_AgePositive"].Value);
        RequireNonNegative(_errors, _weightKg, L["Validation_WeightNonNegative"].Value);

        if (_errors.Count > 0) return;

        var gender = GetString(form, FGender) is "Female" ? "Female" : "Male";
        var dog = await Api.CreateDog(new CreateDog(_name, _breed, _ageMonths, gender, _weightKg, null, _traits, _notes));
        Nav.NavigateTo($"/dogs/{dog.Id}");
    }
}
