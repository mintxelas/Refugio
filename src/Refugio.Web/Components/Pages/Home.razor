@page "/"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Nav_Dashboard"] – @L["App_Name"]</PageTitle>

@if (_loading)
{
    <div class="flex items-center justify-center h-64">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-primary mb-xs">@L["Home_GoodMorning"]</h2>
            <p class="text-body-lg text-on-surface-variant">@L["Home_Subtitle"]</p>
        </div>
        <div class="text-right">
            <div class="font-label-md text-label-md text-secondary">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</div>
            <div class="text-body-sm text-on-surface-variant">@string.Format(L["Home_ManagingDogs"].Value, _stats?.TotalDogs)</div>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
        <div class="p-md bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 flex items-start justify-between">
            <div>
                <p class="text-label-md font-label-md text-on-surface-variant mb-xs">@L["Home_TotalDogs"]</p>
                <h3 class="font-headline-lg text-headline-lg text-primary">@_stats?.TotalDogs</h3>
                <p class="text-label-sm text-primary flex items-center gap-xs mt-2">
                    <span class="material-symbols-outlined text-base">pets</span>
                    @L["Home_InCareNow"]
                </p>
            </div>
            <a href="/dogs" class="w-12 h-12 rounded-lg bg-primary-fixed flex items-center justify-center text-on-primary-fixed hover:brightness-90 transition-all">
                <span class="material-symbols-outlined">pets</span>
            </a>
        </div>
        <div class="p-md bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 flex items-start justify-between">
            <div>
                <p class="text-label-md font-label-md text-on-surface-variant mb-xs">@L["Home_NewAdoptions"]</p>
                <h3 class="font-headline-lg text-headline-lg text-secondary">@_stats?.NewAdoptions</h3>
                <p class="text-label-sm text-secondary flex items-center gap-xs mt-2">
                    <span class="material-symbols-outlined text-base">calendar_month</span>
                    @L["Home_ThisWeek"]
                </p>
            </div>
            <a href="/adoptions" class="w-12 h-12 rounded-lg bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed hover:brightness-90 transition-all">
                <span class="material-symbols-outlined">favorite</span>
            </a>
        </div>
        <div class="p-md bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 flex items-start justify-between">
            <div>
                <p class="text-label-md font-label-md text-on-surface-variant mb-xs">@L["Home_UrgentMeds"]</p>
                <h3 class="font-headline-lg text-headline-lg text-error">@_stats?.UrgentMeds</h3>
                <p class="text-label-sm text-error flex items-center gap-xs mt-2">
                    <span class="material-symbols-outlined text-base">emergency</span>
                    @L["Home_NeedsAttention"]
                </p>
            </div>
            <a href="/health" class="w-12 h-12 rounded-lg bg-error-container flex items-center justify-center text-on-error-container hover:brightness-90 transition-all">
                <span class="material-symbols-outlined">medication</span>
            </a>
        </div>
        <div class="p-md bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30">
            <div class="flex items-start justify-between mb-sm">
                <div>
                    <p class="text-label-md font-label-md text-on-surface-variant">@L["Home_DonationGoal"]</p>
                    <h3 class="font-headline-lg text-headline-lg text-tertiary">$@(_stats?.TotalDonations.ToString("N0"))</h3>
                </div>
                <a href="/funds" class="w-12 h-12 rounded-lg bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed hover:brightness-90 transition-all">
                    <span class="material-symbols-outlined">payments</span>
                </a>
            </div>
            @{
                var pct = _stats is null ? 0 : (int)(_stats.TotalDonations / _stats.DonationGoal * 100);
            }
            <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden">
                <div class="bg-primary h-full rounded-full transition-all" style="width:@pct%"></div>
            </div>
            <p class="text-label-sm text-on-surface-variant mt-2 text-right">@string.Format(L["Home_PctOfGoal"].Value, pct, _stats?.DonationGoal.ToString("N0"))</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
        <!-- Upcoming Tasks -->
        <div class="lg:col-span-1 space-y-md">
            <div class="flex items-center justify-between">
                <h3 class="font-headline-md text-headline-md text-on-surface">@L["Home_UpcomingTasks"]</h3>
                <a href="/calendar" class="text-primary font-label-md text-label-md hover:underline">@L["Home_ViewAll"]</a>
            </div>
            <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
                <div class="divide-y divide-outline-variant/20">
                    @foreach (var task in _tasks)
                    {
                        <div class="p-md flex gap-sm items-start hover:bg-surface-container transition-colors group">
                            @if (!task.IsCompleted)
                            {
                                <form method="post" action="/api/tasks/@task.Id/complete" class="contents">
                                    <AntiforgeryToken />
                                    <button type="submit" class="mt-1 flex-shrink-0 w-5 h-5 rounded border-2 border-outline-variant hover:border-primary hover:bg-primary/10 transition-all inline-flex items-center justify-center">
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="mt-1 flex-shrink-0 w-5 h-5 rounded bg-primary border-2 border-primary inline-flex items-center justify-center">
                                    <span class="material-symbols-outlined text-on-primary" style="font-size:12px">check</span>
                                </span>
                            }
                            <div class="flex-1">
                                <h4 class="font-label-md text-label-md text-on-surface @(task.IsCompleted ? "line-through text-on-surface-variant" : "")">@task.Title</h4>
                                <p class="text-body-sm text-on-surface-variant">@task.DueDateTime.ToString("h:mm tt")@(task.AssignedVolunteer is not null ? $" • {task.AssignedVolunteer.Name}" : "")</p>
                            </div>
                            <AuthorizeView Roles="Manager">
                                <form method="post" action="/api/tasks/@task.Id/delete" class="contents">
                                    <AntiforgeryToken />
                                    <button type="submit"
                                            class="opacity-0 group-hover:opacity-100 w-7 h-7 flex items-center justify-center rounded text-error hover:bg-error-container/20 transition-all flex-shrink-0"
                                            title="@L["Common_Delete"]"
                                            onclick="return confirm('@task.Title?')">
                                        <span class="material-symbols-outlined" style="font-size:16px">delete</span>
                                    </button>
                                </form>
                            </AuthorizeView>
                        </div>
                    }
                </div>
            </div>

            <!-- Add Task form -->
            <details class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden">
                <summary class="p-md flex items-center gap-sm cursor-pointer text-primary font-label-md hover:bg-surface-container transition-colors list-none">
                    <span class="material-symbols-outlined text-base">add_circle</span>
                    @L["Tasks_AddTask"]
                </summary>
                <div class="p-md border-t border-outline-variant/20">
                    <form method="post" @formname="add-task" class="space-y-sm">
                        <AntiforgeryToken />
                        <div>
                            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-xs">@L["Tasks_Title"] *</label>
                            <input name="Title" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-xs">@L["Tasks_DueDate"] *</label>
                            <input name="DueDateTime" type="datetime-local" required
                                   value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")"
                                   class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-xs">@L["Tasks_AssignTo"]</label>
                            <select name="AssignedVolunteerId" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                                <option value="">@L["Tasks_Unassigned"]</option>
                                @foreach (var v in _volunteers)
                                {
                                    <option value="@v.Id">@v.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-xs">@L["Tasks_Location"]</label>
                            <input name="Location" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                            <textarea name="Notes" rows="2" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none resize-none"></textarea>
                        </div>
                        <button type="submit" class="w-full py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Tasks_AddTask"]
                        </button>
                    </form>
                </div>
            </details>
        </div>

        <!-- Dogs Needing Attention -->
        <div class="lg:col-span-2 space-y-md">
            <div class="flex items-center justify-between">
                <h3 class="font-headline-md text-headline-md text-on-surface">@L["Home_DogsNeedingAttention"]</h3>
                <div class="flex gap-sm">
                    <span class="px-sm py-1 rounded-full bg-error-container text-on-error-container text-label-sm font-label-sm">@string.Format(L["Home_MedicalCount"].Value, _medicalDogs.Count)</span>
                    <span class="px-sm py-1 rounded-full bg-primary-fixed text-on-primary-fixed text-label-sm font-label-sm">@string.Format(L["Home_TotalCount"].Value, _stats?.TotalDogs)</span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                @foreach (var dog in _medicalDogs.Take(3))
                {
                    <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 overflow-hidden flex flex-col group">
                        <div class="relative h-40 bg-surface-container-high flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary-fixed-dim text-6xl" style="font-variation-settings:'FILL' 1">pets</span>
                            <div class="absolute top-sm right-sm">
                                @if (dog.Status == DogStatus.Medical)
                                {
                                    <span class="bg-error px-sm py-1 rounded-full text-on-error text-label-sm font-label-sm flex items-center gap-xs shadow-md">
                                        <span class="material-symbols-outlined text-sm">medical_services</span>
                                        @L["Home_MedicationDue"]
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-secondary-container px-sm py-1 rounded-full text-on-secondary-container text-label-sm font-label-sm flex items-center gap-xs shadow-md">
                                        <span class="material-symbols-outlined text-sm">new_releases</span>
                                        @DogStatusDisplay(dog.Status, L)
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="p-md space-y-sm">
                            <div>
                                <h4 class="font-headline-md text-headline-md text-on-surface">@dog.Name</h4>
                                <p class="text-body-sm text-on-surface-variant">@AgeDisplay(dog.AgeMonths, L) • @dog.Breed</p>
                            </div>
                            @if (!string.IsNullOrEmpty(dog.Traits))
                            {
                                <div class="flex flex-wrap gap-xs">
                                    @foreach (var tag in dog.Traits.Split(','))
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-label-sm">@tag.Trim()</span>
                                    }
                                </div>
                            }
                            <div class="pt-sm border-t border-outline-variant/30 flex gap-sm">
                                <a href="/dogs/@dog.Id" class="flex-1 bg-primary text-on-primary py-2 rounded-lg font-label-md text-label-md text-center hover:brightness-110 transition-all">
                                    @L["Common_ViewDetails"]
                                </a>
                                <a href="/health?dogId=@dog.Id" class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container-high transition-all">
                                    <span class="material-symbols-outlined">medical_services</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                <a href="/dogs/new" class="border-2 border-dashed border-outline-variant rounded-xl flex flex-col items-center justify-center p-md group hover:border-primary hover:bg-primary-container/5 transition-all cursor-pointer">
                    <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mb-md group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-primary text-4xl">add</span>
                    </div>
                    <p class="font-headline-md text-headline-md text-on-surface-variant group-hover:text-primary">@L["Common_AddNewAnimal"]</p>
                    <p class="text-body-sm text-on-surface-variant">@L["Home_QuickCheckin"]</p>
                </a>
            </div>
        </div>
    </div>
</section>
}

@code {
    private const string FTitle = "Title";
    private const string FDueDateTime = "DueDateTime";
    private const string FAssignedVolunteerId = "AssignedVolunteerId";
    private const string FLocation = "Location";
    private const string FNotes = "Notes";

    private bool _loading = true;
    private DashboardStats? _stats;
    private List<ShelterTask> _tasks = [];
    private List<Dog> _medicalDogs = [];
    private List<Volunteer> _volunteers = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var title = form[FTitle].ToString();
            if (!string.IsNullOrWhiteSpace(title)
                && DateTime.TryParse(form[FDueDateTime].ToString(), out var due))
            {
                int? volunteerId = int.TryParse(form[FAssignedVolunteerId].ToString(), out var vid) && vid > 0 ? vid : null;
                var location = form[FLocation].ToString() is { Length: > 0 } loc ? loc : null;
                var notes = form[FNotes].ToString() is { Length: > 0 } n ? n : null;
                await Api.CreateTask(new CreateTask(title, due, notes, volunteerId, location));
                Nav.NavigateTo("/");
                return;
            }
        }

        _stats = await Api.GetDashboardStats();
        _tasks = await Api.GetTasks();
        var allDogs = await Api.GetDogs();
        _medicalDogs = allDogs.Where(d => d.Status == DogStatus.Medical || d.Status == DogStatus.Available).Take(4).ToList();
        _volunteers = await Api.GetVolunteers();
        _loading = false;
    }

}
