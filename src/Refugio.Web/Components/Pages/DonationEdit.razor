@page "/funds/donations/{Id:int}"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Funds_EditDonation"] – @L["App_Name"]</PageTitle>

@if (_donation is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/funds" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-primary">@L["Funds_EditDonation"]</h2>
                <p class="text-body-md text-on-surface-variant">@_donation.DonorName</p>
            </div>
        </div>

        @if (_errors.Count > 0)
        {
            <div class="mb-md bg-error-container text-on-error-container rounded-xl p-md space-y-xs">
                @foreach (var e in _errors)
                {
                    <p class="text-body-sm flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">error</span> @e
                    </p>
                }
            </div>
        }

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-donation" @onsubmit="Save" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_DonorName"]</label>
                        <input name="DonorName" required value="@_donation.DonorName"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Funds_AmountRequired"]</label>
                        <input name="Amount" type="number" step="0.01" min="0.01" required value="@_donation.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Category"]</label>
                        <select name="Category" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            @foreach (var cat in Enum.GetValues<DonationCategory>())
                            {
                                <option value="@cat" selected="@(_donation.Category == cat ? "selected" : null)">@L[$"DonationCategory_{cat}"]</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                        <input name="Notes" value="@_donation.Notes"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <AuthorizeView Roles="Manager">
                        <button type="submit" formaction="/api/donations/@Id/delete"
                                class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                                onclick="return confirm('Delete this donation?')">
                            @L["Common_Delete"]
                        </button>
                    </AuthorizeView>
                    <div class="flex gap-sm">
                        <a href="/funds" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            @L["Common_Cancel"]
                        </a>
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Common_SaveChanges"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private const string FDonorName = "DonorName";
    private const string FAmount = "Amount";
    private const string FCategory = "Category";
    private const string FNotes = "Notes";

    [Parameter] public int Id { get; set; }

    private Donation? _donation;
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        _donation = await Api.GetDonation(Id);
        if (_donation is null) Nav.NavigateTo("/funds");
    }

    private async Task Save()
    {
        if (_donation is null) return;
        var form = await HttpContextAccessor.HttpContext!.Request.ReadFormAsync();
        var name = GetString(form, FDonorName);
        var amount = GetDecimal(form, FAmount);

        RequireNotEmpty(_errors, name, L["Validation_DonorNameRequired"].Value);
        RequirePositive(_errors, amount, L["Validation_AmountPositive"].Value);
        if (_errors.Count > 0) return;

        await Api.UpdateDonation(new UpdateDonation(
            Id, name, amount,
            GetEnum(form, FCategory, DonationCategory.OneTime),
            GetStringOrNull(form, FNotes)));
        Nav.NavigateTo("/funds");
    }
}
