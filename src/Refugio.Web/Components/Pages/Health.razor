@page "/health"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Nav_Health"] – @L["App_Name"]</PageTitle>

<section class="p-margin-desktop space-y-lg max-w-screen-xl mx-auto">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-primary">@L["Health_Title"]</h2>
            <p class="text-body-md text-on-surface-variant">@L["Health_Subtitle"]</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
        <!-- Dog selector -->
        <div class="space-y-md">
            <h3 class="font-headline-md text-headline-md text-on-surface">@L["Health_SelectAnimal"]</h3>
            <div class="space-y-xs max-h-[60vh] overflow-y-auto">
                @foreach (var dog in _dogs)
                {
                    var isSelected = _selectedDog?.Id == dog.Id;
                    <a href="/health?dogId=@dog.Id"
                       class="w-full flex items-center gap-sm p-sm rounded-xl border transition-all @(isSelected ? "bg-primary-container/10 border-primary" : "bg-surface-container-lowest border-outline-variant/30 hover:border-primary/50")">
                        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1">pets</span>
                        </div>
                        <div class="text-left">
                            <p class="font-label-md text-on-surface">@dog.Name</p>
                            <p class="text-body-sm text-on-surface-variant">@dog.Breed</p>
                        </div>
                        @if (dog.Status == DogStatus.Medical)
                        {
                            <span class="ml-auto bg-error text-on-error text-label-sm rounded-full px-xs py-0.5">!</span>
                        }
                    </a>
                }
            </div>
        </div>

        <!-- Records panel -->
        <div class="lg:col-span-2 space-y-md">
            @if (_selectedDog is null)
            {
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg flex flex-col items-center text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-6xl mb-md text-primary-fixed-dim">medical_services</span>
                    <p class="text-body-lg">@L["Health_SelectToView"]</p>
                </div>
            }
            else
            {
                <!-- Medical Records -->
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <div class="flex justify-between items-center mb-md">
                        <h3 class="font-headline-md text-headline-md text-on-surface">@string.Format(L["Health_MedicalHistory"].Value, _selectedDog.Name)</h3>
                    </div>

                    @if (!_records.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant py-md text-center">@string.Format(L["Health_NoRecords"].Value, _selectedDog.Name)</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20 mb-md">
                            @foreach (var (rec, i) in _records.Select((r, i) => (r, i)))
                            {
                                <div class="py-sm @(i % 2 == 0 ? "" : "bg-tertiary-fixed/10") px-sm rounded">
                                    <div class="flex justify-between items-start">
                                        <h4 class="font-label-md text-on-surface">@rec.Diagnosis</h4>
                                        <span class="text-body-sm text-on-surface-variant">@rec.VisitDate.ToString("MMM d, yyyy")</span>
                                    </div>
                                    <p class="text-body-sm text-on-surface-variant">Dr. @rec.VetName • @rec.Treatment</p>
                                    @if (rec.NextVisitDate.HasValue)
                                    {
                                        <p class="text-label-sm text-primary mt-xs">@L["Health_NextVisitLabel"] @rec.NextVisitDate.Value.ToString("MMM d, yyyy")</p>
                                    }
                                    @if (!string.IsNullOrEmpty(rec.Notes))
                                    {
                                        <p class="text-body-sm text-on-surface-variant italic">@rec.Notes</p>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <details class="border border-outline-variant/30 rounded-xl overflow-hidden">
                        <summary class="flex items-center gap-xs px-sm py-2 cursor-pointer hover:bg-surface-container transition-colors select-none list-none">
                            <span class="material-symbols-outlined text-base text-primary">add</span>
                            <span class="font-label-sm text-label-sm text-primary">@L["Health_AddRecord"]</span>
                        </summary>
                        <div class="p-md border-t border-outline-variant/30 bg-surface-container-low">
                            <form method="post" @formname="add-record" class="space-y-sm">
                                <AntiforgeryToken />
                                <div class="grid grid-cols-2 gap-sm">
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_VetName"]</label>
                                        <input name="VetName" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_Diagnosis"]</label>
                                        <input name="Diagnosis" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_Treatment"]</label>
                                        <input name="Treatment" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_NextVisit"]</label>
                                        <input name="NextVisitDate" type="date" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                </div>
                                <div class="flex gap-sm justify-end">
                                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110">@L["Health_SaveRecord"]</button>
                                </div>
                            </form>
                        </div>
                    </details>
                </div>

                <!-- Medications -->
                <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-md">
                    <div class="flex justify-between items-center mb-md">
                        <h3 class="font-headline-md text-headline-md text-on-surface">@L["Health_Medications"]</h3>
                    </div>

                    @if (!_medications.Any())
                    {
                        <p class="text-body-sm text-on-surface-variant py-md text-center">@string.Format(L["Health_NoMedications"].Value, _selectedDog.Name)</p>
                    }
                    else
                    {
                        <div class="divide-y divide-outline-variant/20 mb-md">
                            @foreach (var med in _medications)
                            {
                                <div class="py-sm flex items-center justify-between">
                                    <div>
                                        <p class="font-label-md text-on-surface">@med.Name</p>
                                        <p class="text-body-sm text-on-surface-variant">@med.Dosage • @med.Frequency</p>
                                    </div>
                                    <div class="flex items-center gap-sm">
                                        @if (med.IsActive)
                                        {
                                            <span class="bg-primary-fixed text-on-primary-fixed text-label-sm rounded-full px-sm py-0.5">@L["Health_MedActive"]</span>
                                            @if (med.EndDate.HasValue)
                                            {
                                                <span class="text-body-sm @(med.EndDate < DateTime.UtcNow.AddDays(3) ? "text-error font-semibold" : "text-on-surface-variant")">
                                                    @string.Format(L["Health_MedUntil"].Value, med.EndDate.Value.ToString("MMM d"))
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="bg-surface-container-high text-on-surface-variant text-label-sm rounded-full px-sm py-0.5">@L["Health_MedCompleted"]</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <details class="border border-outline-variant/30 rounded-xl overflow-hidden">
                        <summary class="flex items-center gap-xs px-sm py-2 cursor-pointer hover:bg-surface-container transition-colors select-none list-none">
                            <span class="material-symbols-outlined text-base text-primary">add</span>
                            <span class="font-label-sm text-label-sm text-primary">@L["Health_AddMedication"]</span>
                        </summary>
                        <div class="p-md border-t border-outline-variant/30 bg-surface-container-low">
                            <form method="post" @formname="add-med" class="space-y-sm">
                                <AntiforgeryToken />
                                <div class="grid grid-cols-2 gap-sm">
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Name"]</label>
                                        <input name="Name" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_Dosage"]</label>
                                        <input name="Dosage" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_Frequency"]</label>
                                        <input name="Frequency" placeholder="@L["Health_FrequencyPlaceholder"]" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                    <div>
                                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Health_EndDate"]</label>
                                        <input name="EndDate" type="date" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary" />
                                    </div>
                                </div>
                                <div class="flex gap-sm justify-end">
                                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110">@L["Health_AddMedication"]</button>
                                </div>
                            </form>
                        </div>
                    </details>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery] public int? DogId { get; set; }

    private List<Dog> _dogs = [];
    private Dog? _selectedDog;
    private List<MedicalRecord> _records = [];
    private List<Medication> _medications = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var handler = form["_handler"].ToString();

            if (handler == "add-record" && DogId.HasValue)
            {
                var diagnosis = form["Diagnosis"].ToString();
                if (!string.IsNullOrWhiteSpace(diagnosis))
                {
                    DateTime? nextVisit = DateTime.TryParse(form["NextVisitDate"].ToString(), out var nv) ? nv : null;
                    await Api.CreateMedicalRecord(new CreateMedicalRecord(
                        DogId.Value,
                        form["VetName"].ToString(),
                        diagnosis,
                        form["Treatment"].ToString(),
                        null,
                        nextVisit));
                }
                Nav.NavigateTo($"/health?dogId={DogId}");
                return;
            }
            else if (handler == "add-med" && DogId.HasValue)
            {
                var name = form["Name"].ToString();
                if (!string.IsNullOrWhiteSpace(name))
                {
                    DateTime? endDate = DateTime.TryParse(form["EndDate"].ToString(), out var ed) ? ed : null;
                    await Api.CreateMedication(new CreateMedication(
                        DogId.Value,
                        name,
                        form["Dosage"].ToString(),
                        form["Frequency"].ToString(),
                        DateTime.UtcNow,
                        endDate));
                }
                Nav.NavigateTo($"/health?dogId={DogId}");
                return;
            }
        }

        _dogs = await Api.GetDogs();
        if (DogId.HasValue)
        {
            _selectedDog = _dogs.FirstOrDefault(d => d.Id == DogId);
            if (_selectedDog is not null)
            {
                _records = await Api.GetMedicalRecords(_selectedDog.Id);
                _medications = await Api.GetMedications(_selectedDog.Id);
            }
        }
    }
}
