@page "/dogs/{Id:int}/edit"
@layout MainLayout
@attribute [Authorize]
@inject ShelterApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Common_Edit"] @(_dog?.Name ?? "") – @L["App_Name"]</PageTitle>

@if (_dog is null)
{
    <div class="p-margin-desktop flex justify-center py-16">
        <span class="material-symbols-outlined text-primary text-4xl animate-spin">autorenew</span>
    </div>
}
else
{
    <section class="p-margin-desktop max-w-2xl">
        <div class="flex items-center gap-sm mb-lg">
            <a href="/dogs/@Id" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h2 class="font-headline-xl text-headline-xl text-primary">@L["Common_Edit"] @_dog.Name</h2>
                <p class="text-body-md text-on-surface-variant">@AgeDisplay(_dog.AgeMonths, L) • @_dog.Breed</p>
            </div>
        </div>

        <!-- Photo upload -->
        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg mb-md">
            <h3 class="font-label-md text-label-md text-on-surface-variant mb-md">@L["Dogs_Photo"]</h3>
            <div class="flex items-center gap-md">
                <div class="w-24 h-24 rounded-xl bg-surface-container-high flex items-center justify-center overflow-hidden flex-shrink-0">
                    @if (!string.IsNullOrEmpty(_dog.PhotoUrl))
                    {
                        <img src="@_dog.PhotoUrl" alt="@_dog.Name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-primary-fixed-dim text-5xl" style="font-variation-settings:'FILL' 1">pets</span>
                    }
                </div>
                <form method="post" action="/api/dogs/@Id/photo" enctype="multipart/form-data" class="flex-1 flex items-center gap-sm">
                    <input type="file" name="Photo" accept=".jpg,.jpeg,.png,.webp" required
                           class="flex-1 text-body-sm text-on-surface-variant file:mr-sm file:px-sm file:py-1 file:rounded-lg file:border-0 file:bg-primary/10 file:text-primary file:font-label-sm file:cursor-pointer cursor-pointer" />
                    <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-sm hover:brightness-110 transition-all flex-shrink-0">
                        @(_dog.PhotoUrl is null ? L["Dogs_UploadPhoto"] : L["Dogs_ChangePhoto"])
                    </button>
                </form>
            </div>
            <p class="text-label-sm text-on-surface-variant mt-xs">@L["Dogs_PhotoHint"]</p>
        </div>

        @if (_errors.Count > 0)
        {
            <div class="mb-md bg-error-container text-on-error-container rounded-xl p-md space-y-xs">
                @foreach (var e in _errors)
                {
                    <p class="text-body-sm flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base">error</span> @e
                    </p>
                }
            </div>
        }

        <div class="bg-surface-container-lowest rounded-xl shadow-soft border border-outline-variant/30 p-lg">
            <form method="post" @formname="edit-dog" class="space-y-md">
                <AntiforgeryToken />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_NameRequired"]</label>
                        <input name="Name" required value="@_dog.Name"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_BreedRequired"]</label>
                        <input name="Breed" required value="@_dog.Breed"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_AgeMonths"]</label>
                        <input name="AgeMonths" type="number" min="1" required value="@_dog.AgeMonths"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_GenderRequired"]</label>
                        <select name="Gender" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            <option value="Male" selected="@(_dog.Gender == "Male" ? "selected" : null)">@L["DogDetail_Male"]</option>
                            <option value="Female" selected="@(_dog.Gender == "Female" ? "selected" : null)">@L["DogDetail_Female"]</option>
                        </select>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Status"]</label>
                        <select name="Status" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none bg-white">
                            @foreach (var s in Enum.GetValues<DogStatus>())
                            {
                                <option value="@s" selected="@(_dog.Status == s ? "selected" : null)">@DogStatusDisplay(s, L)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_WeightKg"]</label>
                        <input name="WeightKg" type="number" step="0.1" min="0" value="@_dog.WeightKg.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                    <div class="col-span-2">
                        <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["DogDetail_Traits"]</label>
                        <input name="Traits" value="@_dog.Traits" placeholder="@L["DogDetail_TraitsPlaceholder"]"
                               class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                    </div>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant block mb-xs">@L["Common_Notes"]</label>
                    <textarea name="Notes" rows="3" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:ring-2 focus:ring-primary focus:outline-none resize-none">@_dog.Notes</textarea>
                </div>
                <div class="flex gap-sm justify-between pt-sm border-t border-outline-variant/20">
                    <AuthorizeView Roles="Manager">
                        <form method="post" action="/api/dogs/@Id/delete" class="inline">
                            <AntiforgeryToken />
                            <button type="submit"
                                    class="px-md py-2 rounded-lg border border-error text-error font-label-md hover:bg-error-container/20 transition-colors"
                                    onclick="return confirm('@L["Common_Delete"] @(_dog?.Name)?')">
                                @L["Common_Delete"]
                            </button>
                        </form>
                    </AuthorizeView>
                    <div class="flex gap-sm">
                        <a href="/dogs/@Id" class="px-md py-2 rounded-lg border border-outline text-on-surface-variant font-label-md hover:bg-surface-container transition-colors">
                            @L["Common_Cancel"]
                        </a>
                        <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md hover:brightness-110 transition-all">
                            @L["Common_SaveChanges"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

@code {
    private const string FName = "Name";
    private const string FBreed = "Breed";
    private const string FAgeMonths = "AgeMonths";
    private const string FWeightKg = "WeightKg";
    private const string FGender = "Gender";
    private const string FStatus = "Status";
    private const string FTraits = "Traits";
    private const string FNotes = "Notes";

    [Parameter] public int Id { get; set; }

    private Dog? _dog;
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Request.Method == "POST")
        {
            var form = await ctx.Request.ReadFormAsync();
            var name = GetString(form, FName);
            var breed = GetString(form, FBreed);
            var age = GetInt(form, FAgeMonths);
            var weight = GetDecimal(form, FWeightKg);

            RequireNotEmpty(_errors, name, L["Validation_NameRequired"].Value);
            RequireNotEmpty(_errors, breed, L["Validation_BreedRequired"].Value);
            RequirePositive(_errors, age, L["Validation_AgePositive"].Value);
            RequireNonNegative(_errors, weight, L["Validation_WeightNonNegative"].Value);

            if (_errors.Count == 0)
            {
                var gender = GetString(form, FGender) is "Female" ? "Female" : "Male";
                var status = GetEnum(form, FStatus, DogStatus.Available);
                await Api.UpdateDog(new UpdateDog(
                    Id, name, breed, age, gender, status, weight,
                    null,
                    GetStringOrNull(form, FTraits),
                    GetStringOrNull(form, FNotes)));
                Nav.NavigateTo($"/dogs/{Id}");
                return;
            }
        }

        _dog = await Api.GetDog(Id);
        if (_dog is null) Nav.NavigateTo("/dogs");
    }

}
